<script>
(function(){
"use strict";

const cfg=__CLIENT_CONFIG__;

const state={
data:[],
meta:{},
view:"tree",
search:"",
expanded:new Set(["$"]),
selectedTree:null,
selectedRow:null,
sortKey:null,
sortDir:1,
filterKeyIndex:"",
operator:"contains",
filterValue:"",
filterType:"auto",
profiles:[],
profileMap:new Map(),
skipped:new Map(),
tableSources:[],
tableSourceIndex:0,
columnWidths:{}
};

const $=id=>document.getElementById(id);

const els={
refresh:$("refreshBtn"),
save:$("saveBtn"),
unitCount:$("unitCount"),
lineCount:$("lineCount"),
windowText:$("windowText"),
statusText:$("statusText"),
batchContent:$("batchContent"),
treeTab:$("treeTab"),
tableTab:$("tableTab"),
search:$("searchInput"),
searchClear:$("searchClear"),
expand:$("expandBtn"),
collapse:$("collapseBtn"),
filterKey:$("filterKey"),
filterOperator:$("filterOperator"),
filterValue:$("filterValue"),
filterType:$("filterType"),
clearFilter:$("clearFilter"),
copyPath:$("copyPath"),
copyValue:$("copyValue"),
copyRow:$("copyRow"),
resultText:$("resultText"),
treeView:$("treeView"),
tableView:$("tableView"),
treeBody:$("treeBody"),
tableSource:$("tableSource"),
tableTop:$("tableTop"),
tableWrap:$("tableWrap"),
reportSummary:$("reportSummary"),
reportWrap:$("reportWrap"),
loading:$("loading"),
toast:$("toast")
};

function isObject(v){
return v!==null&&typeof v==="object"&&!Array.isArray(v);
}

function valueType(v){
if(v===null)return "Null";
if(Array.isArray(v))return "Array";
if(typeof v==="boolean")return "Boolean";
if(typeof v==="number")return "Number";
if(typeof v==="string")return "String";
if(typeof v==="object")return "Object";
return "String";
}

function compact(v){
if(v===null)return "null";
if(Array.isArray(v))return "["+v.length+" items]";
if(isObject(v))return "{"+Object.keys(v).length+" keys}";
if(typeof v==="string")return JSON.stringify(v.length>90?v.slice(0,87)+"…":v);
return String(v);
}

function jsonText(v,pretty){
try{
return JSON.stringify(v,null,pretty?2:0);
}catch(e){
return String(v);
}
}

function pathPart(key){
return /^[A-Za-z_$][A-Za-z0-9_$]*$/.test(key)?
"."+key:
"["+JSON.stringify(key)+"]";
}

function childPath(parent,key,arrayParent){
return arrayParent?
parent+"["+key+"]":
parent+pathPart(String(key));
}

function relativePath(segments){
if(!segments.length)return "$";
let out="";
segments.forEach((s,i)=>{
const k=String(s);
if(i===0){
out+=/^[A-Za-z_$][A-Za-z0-9_$]*$/.test(k)?
k:
"["+JSON.stringify(k)+"]";
}else{
out+=pathPart(k);
}
});
return out;
}

function getAt(obj,segments){
let cur=obj;
for(let i=0;i<segments.length;i++){
if(cur===null||
cur===undefined||
typeof cur!=="object"||
!(segments[i] in cur)){
return {exists:false,value:undefined};
}
cur=cur[segments[i]];
}
return {exists:true,value:cur};
}

function setText(el,text){
el.textContent=text===undefined||text===null?"":String(text);
}

let toastTimer=null;

function toast(message,error){
clearTimeout(toastTimer);
els.toast.textContent=message;
els.toast.className="toast show"+(error?" error":"");
toastTimer=setTimeout(()=>{
els.toast.className="toast";
},3200);
}

function loading(on){
els.loading.classList.toggle("show",!!on);
els.refresh.disabled=!!on;
}

function status(ok,text){
els.statusText.textContent="";
const dot=document.createElement("span");
dot.className="status-dot "+(ok?"good":"bad");
els.statusText.appendChild(dot);
els.statusText.appendChild(document.createTextNode(text));
}

function postPath(){
return cfg.apiPostPath&&cfg.apiPostPath.trim()?
cfg.apiPostPath:
window.location.pathname;
}

async function loadData(){
loading(true);
status(false,"Loading");

try{
const response=await fetch(postPath(),{
method:"POST",
credentials:"same-origin",
headers:{
"Content-Type":"application/json",
"Accept":"application/json"
},
body:JSON.stringify({
action:"load"
})
});

let body=null;

try{
body=await response.json();
}catch(e){
throw new Error("Server returned a non-JSON response.");
}

if(!response.ok){
throw new Error("HTTP "+response.status);
}

if(!body||body.ok!==true){
throw new Error(
body&&body.error?
body.error:
"The server did not return a successful result."
);
}

const payload=body.data||{};

state.data=Array.isArray(payload.rows)?payload.rows:[];
state.meta=payload.meta||{};
state.expanded=new Set(["$"]);
state.selectedTree=null;
state.selectedRow=null;
state.sortKey=null;
state.sortDir=1;
state.search="";
state.filterKeyIndex="";
state.operator="contains";
state.filterValue="";
state.filterType="auto";
state.columnWidths={};

els.search.value="";
els.filterOperator.value="contains";
els.filterValue.value="";
els.filterType.value="auto";

buildProfiles();
buildTableSources();
populateFilterKeys();
renderMeta();
renderAll();
status(true,"Current");

}catch(e){

state.data=[];
state.meta={};

buildProfiles();
buildTableSources();
populateFilterKeys();
renderMeta();
renderAll();

status(false,"Error");
toast(e.message||String(e),true);

}finally{
loading(false);
}
}

function renderMeta(){
setText(
els.unitCount,
state.meta.totalRows!==undefined?
state.meta.totalRows:
state.data.length
);

const lines=Array.isArray(state.meta.lines)?
state.meta.lines:
[];

setText(els.lineCount,lines.length||"0");

const start=state.meta.startTime||"";
const end=state.meta.endTime||"";

setText(
els.windowText,
start&&end?
start+" → "+end:
"—"
);

els.batchContent.textContent="";

if(!lines.length){
const d=document.createElement("div");
d.className="empty";
d.textContent="No line or batch information returned.";
els.batchContent.appendChild(d);
return;
}

lines.forEach(line=>{
const row=document.createElement("div");
row.className="batch-line";

const name=document.createElement("div");
name.className="batch-name";
name.textContent=line.name||"Line";

const chips=document.createElement("div");
chips.className="batch-chips";

const batches=Array.isArray(line.batches)?
line.batches:
[];

if(!batches.length){
const c=document.createElement("span");
c.className="chip";
c.textContent="No batches";
chips.appendChild(c);
}else{
batches.forEach(b=>{
const c=document.createElement("span");
c.className="chip";
c.textContent=String(b);
chips.appendChild(c);
});
}

const count=document.createElement("span");
count.className="chip";
count.textContent=String(line.rowCount||0)+" units";
chips.appendChild(count);

row.appendChild(name);
row.appendChild(chips);
els.batchContent.appendChild(row);
});
}

function walkFields(obj,segments,fn){
if(!isObject(obj))return;

Object.keys(obj).forEach(key=>{
const next=segments.concat([key]);
const value=obj[key];

fn(next,value);

if(isObject(value)){
walkFields(value,next,fn);
}
});
}

function booleanishName(label){
return /(^|[._])(is|has|can|enabled|active|manual|flag|bool|boolean|success|valid|complete|completed)([._]|$)/i.test(label);
}

function buildProfiles(){
const map=new Map();

state.data.forEach(row=>{
if(!isObject(row))return;

walkFields(row,[],(segments,value)=>{
const id=JSON.stringify(segments);

let p=map.get(id);

if(!p){
p={
id:id,
segments:segments,
label:relativePath(segments),
types:new Set(),
samples:[],
values:[],
nulls:0,
inferred:"String",
mixed:false
};

map.set(id,p);
}

if(value===null){
p.nulls++;
return;
}

const t=valueType(value);

p.types.add(t);

if(p.samples.length<4){
p.samples.push(compact(value));
}

