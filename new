        return str(value)


def _parse_body(request):
    raw = None

    try:
        raw = request.get("data")
    except:
        pass

    if raw is None:
        try:
            raw = request.get("postData")
        except:
            pass

    if raw is None:
        try:
            raw = request["data"]
        except:
            pass

    if raw is None:
        try:
            raw = request["postData"]
        except:
            pass

    if raw is None:
        raise Exception("POST body was empty.")

    if isinstance(raw, basestring):
        return json.loads(raw)

    return raw


def _response_ok(data):
    return {
        "json": {
            "ok": True,
            "data": data
        }
    }


def _response_error(message):
    return {
        "json": {
            "ok": False,
            "error": _text(message)
        }
    }


def _get_org():
    if _text(ORG_VALUE).strip():
        return _text(ORG_VALUE).strip()

    params = {
        SITE_SETTINGS_PARAM_NAME: SITE_SETTINGS_PARAM_VALUE
    }

    result = system.db.runNamedQuery(
        SITE_SETTINGS_NAMED_QUERY,
        params
    )

    if result is None or result.getRowCount() < 1:
        raise Exception(
            "The site settings query did not return an organization value."
        )

    value = result.getValueAt(
        0,
        SITE_SETTINGS_VALUE_COLUMN
    )

    if not _text(value).strip():
        raise Exception(
            "The organization value is blank."
        )

    return _text(value).strip()


def _get_batch_function(function_name):
    function = getattr(
        Metrics.SalvageFunctions,
        function_name,
        None
    )

    if function is None:
        raise Exception(
            "Batch function was not found: %s" %
            function_name
        )

    return function


def _extract_batch_ids(batch_rows):
    batch_ids = []
    seen = set()

    if batch_rows is None:
        return batch_ids

    for batch in batch_rows:
        value = None

        try:
            value = batch[0]
        except:
            value = batch

        text = _text(value).strip()

        if text and text not in seen:
            seen.add(text)
            batch_ids.append(text)

    return batch_ids


def _chunk_batch_ids(batch_ids):
    groups = []

    size = int(API_BATCH_SIZE)

    if size < 1:
        size = 10

    for i in range(
        0,
        len(batch_ids),
        size
    ):
        groups.append(
            ",".join(
                batch_ids[i:i + size]
            )
        )

    return groups


def _encode_query_value(
    value,
    keep_commas=False
):
    safe = "," if keep_commas else ""

    return urllib.quote(
        _text(value).encode("utf-8"),
        safe
    )


def _build_api_url(
    org,
    batch_group
):
    template = _text(
        API_URL_TEMPLATE
    )

    if (
        "{org}" not in template or
        "{batches}" not in template
    ):
        raise Exception(
            "API_URL_TEMPLATE must contain both {org} and {batches}."
        )

    return (
        template
        .replace(
            "{org}",
            _encode_query_value(org)
        )
        .replace(
            "{batches}",
            _encode_query_value(
                batch_group,
                True
            )
        )
    )


def _get_units_from_api(url):
    response = api.GET(url)

    if isinstance(
        response,
        basestring
    ):
        response = json.loads(
            response
        )

    if isinstance(
        response,
        list
    ):
        return response

    if response is None:
        raise Exception(
            "The production API returned no response."
        )

    try:
        units = response.get(
            "unitlist"
        )
    except:
        units = None

    if units is None:
        message = ""

        try:
            message = _text(
                response.get("message")
            ).strip()
        except:
            pass

        if message:
            raise Exception(message)

        raise Exception(
            "The production API response did not contain unitlist."
        )

    try:
        return list(units)
    except:
        raise Exception(
            "The production API unitlist was not iterable."
        )


def _load_current_data():
    end_time = system.date.now()

    start_time = system.date.addMinutes(
        end_time,
        -abs(int(LOOKBACK_MINUTES))
    )

    org = _get_org()

    all_rows = []
    line_meta = []

    for config in LINE_CONFIGS:
        line_name = _text(
            config.get("name")
        ).strip()

        batch_path = config.get(
            "batchPath"
        )

        function_name = config.get(
            "batchFunction"
        )

        batch_function = _get_batch_function(
            function_name
        )

        batch_rows = batch_function(
            start_time,
            end_time,
            batch_path
        )

        batch_ids = _extract_batch_ids(
            batch_rows
        )

        line_rows = []

        for batch_group in _chunk_batch_ids(
            batch_ids
        ):
            line_rows.extend(
                _get_units_from_api(
                    _build_api_url(
                        org,
                        batch_group
                    )
                )
            )

        all_rows.extend(
            line_rows
        )

        line_meta.append({
            "name": line_name,
            "batches": batch_ids,
            "rowCount": len(line_rows)
        })

    return {
        "rows": all_rows,
        "meta": {
            "startTime": system.date.format(
                start_time,
                "yyyy-MM-dd HH:mm:ss"
            ),
            "endTime": system.date.format(
                end_time,
                "yyyy-MM-dd HH:mm:ss"
            ),
            "loadedAt": system.date.format(
                system.date.now(),
                "yyyy-MM-dd HH:mm:ss"
            ),
            "totalRows": len(all_rows),
            "lines": line_meta
        }
    }


def handle_post(
    request,
    session
):
    try:
        body = _parse_body(
            request
        )

        action = _text(
            body.get(
                "action",
                ""
            )
        ).strip().lower()

        if action == "load":
            return _response_ok(
                _load_current_data()
            )

        raise Exception(
            "Unsupported action: %s" %
            action
        )

    except Exception as exc:
        return _response_error(
            exc
        )


def handle_get(
    request,
    session
):
    try:
        client_config = json.dumps({
            "apiPostPath": APP_MOUNT_PATH
        })

        return {
            "html": HTML_TEMPLATE.replace(
                "__CLIENT_CONFIG__",
                client_config
            )
        }

    except Exception as exc:
        return {
            "html":
            "<!doctype html><html><body><pre>%s</pre></body></html>" %
            _text(exc)
        }