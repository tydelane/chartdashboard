def _create_dashboard_row(identity, name, description, config):
    if _dashboard_count(identity["username"]) >= MAX_DASHBOARDS_PER_OWNER:
        raise DashboardError("Dashboard limit reached (%s per owner)." % MAX_DASHBOARDS_PER_OWNER)
    config = _validate_dashboard_config(config)
    dashboard_id = str(UUID.randomUUID())
    name = _unique_dashboard_name(identity["username"], name)
    description = _safe_text(description, MAX_DASHBOARD_DESCRIPTION_LENGTH, "Dashboard description", True)
    _run_update(
        """
        INSERT INTO %s
        (
            DashboardId, OwnerUsername, OwnerDisplayName, DashboardName,
            DashboardDescription, IsShared, ConfigSchemaVersion, ConfigJson,
            CreatedAt, UpdatedAt
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, SYSUTCDATETIME(), SYSUTCDATETIME())
        """ % _qualified_table(),
        [
            dashboard_id, identity["username"], identity["displayName"], name,
            description, False, CONFIG_SCHEMA_VERSION, _config_json(config)
        ]
    )
    return _fetch_owned_dashboard(dashboard_id, identity["username"])
def _create_default_dashboard(identity):
    return _create_dashboard_row(
        identity,
        "Untitled Dashboard",
        "New dashboard",
        _default_dashboard_config()
    )

def _list_owned_dashboards(identity):
    rows = _query_rows(
        _dashboard_select_sql("WHERE OwnerUsername = ? ORDER BY UpdatedAt DESC, DashboardName ASC"),
        [identity["username"]]
    )
    return [_decode_dashboard_row(row) for row in rows]

def _get_dashboard_for_view(identity, dashboard_id):
    dashboard = _fetch_dashboard_by_id(dashboard_id)
    if dashboard is None:
        raise DashboardError("Dashboard was not found.")
    if dashboard["ownerUsername"] != identity["username"] and not dashboard["isShared"]:
        raise DashboardError("You do not have access to this dashboard.")
    return dashboard

def _save_dashboard(identity, payload):
    payload = _require_dict(payload, "Save payload")
    dashboard_id = _safe_text(payload.get("id"), 80, "Dashboard id", False)
    existing = _fetch_owned_dashboard(dashboard_id, identity["username"])
    if existing is None:
        raise DashboardError("Only the dashboard owner can save this dashboard.")

    expected_row_version = _safe_text(payload.get("rowVersion"), 34, "Row version", False)
    config = _validate_dashboard_config(payload.get("config", {}))
    name = _safe_text(payload.get("name"), MAX_DASHBOARD_NAME_LENGTH, "Dashboard name", False)
    description = _safe_text(payload.get("description", ""), MAX_DASHBOARD_DESCRIPTION_LENGTH, "Dashboard description", True)
    is_shared = _as_bool(payload.get("isShared", False))

    # A name remains unique per owner. Permit the current row to keep its name.
    conflicting = _query_one(
        "SELECT DashboardId FROM %s WHERE OwnerUsername = ? AND DashboardName = ? AND DashboardId <> ?" % _qualified_table(),
        [identity["username"], name, dashboard_id]
    )
    if conflicting:
        raise DashboardError("You already have a dashboard with that name.")

    updated = _run_update(
        """
        UPDATE %s
        SET
            OwnerDisplayName = ?,
            DashboardName = ?,
            DashboardDescription = ?,
            IsShared = ?,
            ConfigSchemaVersion = ?,
            ConfigJson = ?,
            UpdatedAt = SYSUTCDATETIME()
        WHERE DashboardId = ?
          AND OwnerUsername = ?
          AND RowVersion = CONVERT(varbinary(8), ?, 1)
        """ % _qualified_table(),
        [
            identity["displayName"], name, description, is_shared,
            CONFIG_SCHEMA_VERSION, _config_json(config),
            dashboard_id, identity["username"], expected_row_version
        ]
    )
    if updated != 1:
        raise DashboardError("Dashboard changed on the server. Reload it before saving again.")
    return _fetch_owned_dashboard(dashboard_id, identity["username"])

def _delete_dashboard(identity, payload):
    payload = _require_dict(payload, "Delete payload")
    dashboard_id = _safe_text(payload.get("id"), 80, "Dashboard id", False)
    row_version = _safe_text(payload.get("rowVersion"), 34, "Row version", False)
    deleted = _run_update(
        """
        DELETE FROM %s
        WHERE DashboardId = ?
          AND OwnerUsername = ?
          AND RowVersion = CONVERT(varbinary(8), ?, 1)
        """ % _qualified_table(),
        [dashboard_id, identity["username"], row_version]
    )
    if deleted != 1:
        raise DashboardError("Dashboard could not be deleted because it changed on the server.")

def _copy_dashboard(identity, payload):
    payload = _require_dict(payload, "Copy payload")
    source_id = _safe_text(payload.get("id"), 80, "Dashboard id", False)
    source = _get_dashboard_for_view(identity, source_id)
    config = {
        "rows": source["rows"],
        "cols": source["cols"],
        "openingLiveRange": source["openingLiveRange"],
        "widgets": source["widgets"]
    }
    return _create_dashboard_row(
        identity,
        source["name"] + " (Copy)",
        source["description"],
        config
    )

def _shared_dashboard_summaries(identity):
    rows = _query_rows(
        """
        SELECT
            DashboardId,
            OwnerUsername,
            OwnerDisplayName,
            DashboardName,
            DashboardDescription,
            ConfigJson,
            UpdatedAt
        FROM %s
        WHERE IsShared = 1
          AND OwnerUsername <> ?
        ORDER BY UpdatedAt DESC, DashboardName ASC
        """ % _qualified_table(),
        [identity["username"]]
    )
    output = []
    for row in rows:
        try:
            widget_count = len(json.loads(_text(_row_value(row, "ConfigJson", "{}"))).get("widgets", []))
        except:
            widget_count = 0
        output.append({
            "id": _text(_row_value(row, "DashboardId")),
            "ownerUsername": _text(_row_value(row, "OwnerUsername")),
            "ownerDisplayName": _text(_row_value(row, "OwnerDisplayName")),
            "name": _text(_row_value(row, "DashboardName")),
            "description": _text(_row_value(row, "DashboardDescription")),
            "widgetCount": widget_count
        })
    return output

