def _to_numeric_or_boolean(value):
    if value is None:
        return None
    if isinstance(value, bool):
        return 1 if value else 0
    try:
        return float(value)
    except:
        try:
            return 1 if _as_bool(value) else 0
        except:
            return None

def _validate_epoch_range(start_ms, end_ms):
    start_ms = long(start_ms)
    end_ms = long(end_ms)
    if end_ms <= start_ms:
        raise DashboardError("End time must be later than start time.")
    if end_ms - start_ms > MAX_QUERY_DURATION_MS:
        raise DashboardError("A historian query cannot exceed %s months." % MAX_QUERY_MONTHS)
    return start_ms, end_ms

def _validate_request_series(value):
    series = _require_list(value, "History series")
    if len(series) > MAX_HISTORY_SERIES_PER_REQUEST:
        raise DashboardError("Too many historian series were requested.")
    seen = set()
    output = []
    for item in series:
        item = _require_dict(item, "History series item")
        path = _validate_tag_path(item.get("path"), False)
        aggregate = _text(item.get("aggregate", "Raw stored values"))
        if aggregate not in ALLOWED_AGGREGATES:
            raise DashboardError("Unsupported historian retrieval mode.")
        key = _safe_text(item.get("key"), 1200, "History series key", False)
        dedupe = path + "|" + aggregate
        if dedupe in seen:
            continue
        seen.add(dedupe)
        output.append({"key": key, "path": path, "aggregate": aggregate})
    return output

def _dataset_series(dataset, keys):
    headers = list(system.dataset.getColumnHeaders(dataset))
    timestamp_index = 0
    for index in range(len(headers)):
        if _text(headers[index]).lower() == "timestamp":
            timestamp_index = index
            break
    positions = {}
    for key in keys:
        for index in range(len(headers)):
            if _text(headers[index]) == key:
                positions[key] = index
                break
    output = dict([(key, []) for key in keys])
    for row_index in range(dataset.getRowCount()):
        timestamp = _epoch_ms(dataset.getValueAt(row_index, timestamp_index))
        if timestamp is None:
            continue
        for key in keys:
            if key not in positions:
                continue
            value = _to_numeric_or_boolean(dataset.getValueAt(row_index, positions[key]))
            if value is not None:
                output[key].append([timestamp, value])
    return output

def _history_query(paths, keys, start_ms, end_ms, aggregate, return_size):
    mode = {
        "Raw stored values": "LastValue",
        "Average": "Average",
        "Min/Max": "MinMax",
        "Last Value": "LastValue"
    }.get(aggregate, "LastValue")
    dataset = system.tag.queryTagHistory(
        paths=paths,
        startDate=_java_date(start_ms),
        endDate=_java_date(end_ms),
        returnSize=return_size,
        aggregationMode=mode,
        returnFormat="Wide",
        columnNames=keys,
        includeBoundingValues=True,
        noInterpolation=True,
        ignoreBadQuality=True
    )
    return _dataset_series(dataset, keys)

def _history_batch(payload):
    payload = _require_dict(payload, "History request")
    start_ms, end_ms = _validate_epoch_range(payload.get("start"), payload.get("end"))
    requested_max = _as_int(payload.get("maxPoints", MAX_HISTORY_POINTS_PER_TAG), MAX_HISTORY_POINTS_PER_TAG)
    max_points = max(10, min(MAX_HISTORY_POINTS_PER_TAG, requested_max))
    series = _validate_request_series(payload.get("series", []))
    response = {}
    grouped = {}
    for item in series:
        grouped.setdefault(item["aggregate"], []).append(item)

    for aggregate, items in grouped.items():
        paths = [item["path"] for item in items]
        keys = [item["key"] for item in items]
        return_size = -1 if aggregate == "Raw stored values" else max_points
        rows_by_key = _history_query(paths, keys, start_ms, end_ms, aggregate, return_size)
        for key in keys:
            rows = rows_by_key.get(key, [])
            if len(rows) > max_points:
                raise DashboardError(
                    "Historian series %s returned more than %s raw rows. Narrow the time range or increase MAX_HISTORY_POINTS_PER_TAG deliberately." %
                    (key, max_points)
                )
            response[key] = rows
    return {"series": response}

def _read_current_batch(payload):
    payload = _require_dict(payload, "Current-value request")
    paths = _require_list(payload.get("paths", []), "Current tag paths")
    if len(paths) > MAX_CURRENT_TAGS_PER_REQUEST:
        raise DashboardError("Too many current tags were requested.")
    valid_paths = [_validate_tag_path(path, False) for path in paths]
    values = system.tag.readBlocking(valid_paths)
    output = {}
    for index in range(len(valid_paths)):
        qualified = values[index]
        value = _to_numeric_or_boolean(qualified.value)
        output[valid_paths[index]] = {
            "value": value,
            "timestamp": _epoch_ms(qualified.timestamp),
            "quality": _text(qualified.quality)
        }
    return {"values": output}

def _as_of_batch(payload):
    payload = _require_dict(payload, "As-of request")
    paths = _require_list(payload.get("paths", []), "As-of tag paths")
    if len(paths) > MAX_CURRENT_TAGS_PER_REQUEST:
        raise DashboardError("Too many as-of tags were requested.")
    valid_paths = [_validate_tag_path(path, False) for path in paths]
    reference_ms = long(payload.get("referenceTime"))
    lookback_start = reference_ms - AS_OF_LOOKBACK_DAYS * 24 * 60 * 60 * 1000
    keys = ["p%s" % index for index in range(len(valid_paths))]
    if not valid_paths:
        return {"values": {}}
    rows_by_key = _history_query(
        valid_paths,
        keys,
        lookback_start,
        reference_ms,
        "Last Value",
        1
    )
    output = {}
    for index in range(len(valid_paths)):
        rows = rows_by_key.get(keys[index], [])
        if rows:
            last = rows[-1]
            output[valid_paths[index]] = {
                "value": last[1],
                "timestamp": last[0]
            }
        else:
            output[valid_paths[index]] = {
                "value": None,
                "timestamp": None
            }
    return {"values": output}

