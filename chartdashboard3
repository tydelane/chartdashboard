def _validate_range_unit(unit):
    unit = _text(unit)
    if unit not in ALLOWED_RANGE_UNITS:
        raise DashboardError("Opening duration unit is not supported.")
    return unit

def _unit_milliseconds(unit):
    return {
        "Seconds": 1000,
        "Minutes": 60000,
        "Hours": 3600000,
        "Days": 86400000,
        "Weeks": 604800000,
        "Months": 30 * 24 * 60 * 60 * 1000
    }[unit]

def _validate_opening_range(value):
    value = _require_dict(value or {}, "openingLiveRange")
    unit = _validate_range_unit(value.get("unit", DEFAULT_OPENING_LIVE_UNIT))
    amount = _as_int(value.get("amount", DEFAULT_OPENING_LIVE_AMOUNT), DEFAULT_OPENING_LIVE_AMOUNT)
    if amount < 1:
        raise DashboardError("Opening duration must be at least one unit.")
    max_amount = int(MAX_QUERY_DURATION_MS / _unit_milliseconds(unit))
    if amount > max_amount:
        raise DashboardError("Opening duration cannot exceed %s months." % MAX_QUERY_MONTHS)
    return {"amount": amount, "unit": unit}

def _validate_tag_path(path, allow_empty=True):
    path = _safe_text(path, 1024, "Tag path", allow_empty)
    if not path:
        return ""
    for root_info in ALLOWED_TAG_ROOTS:
        root = _safe_text(root_info.get("root"), 1024, "ALLOWED_TAG_ROOTS root", False).rstrip("/")
        if path == root or path.startswith(root + "/"):
            return path
    raise DashboardError("Tag path is outside the configured approved roots.")

def _normalize_tag(tag):
    tag = _require_dict(tag or {}, "Tag")
    path = _validate_tag_path(tag.get("path", ""), True)
    mode = _text(tag.get("mode", "Analog"))
    if mode not in ALLOWED_RENDER_MODES:
        raise DashboardError("Tag render mode is not supported.")
    aggregate = _text(tag.get("aggregate", "Raw stored values"))
    if aggregate not in ALLOWED_AGGREGATES:
        raise DashboardError("Tag historian retrieval is not supported.")
    if mode != "Analog":
        aggregate = "Raw stored values"
    line_type = _text(tag.get("lineType", "Solid"))
    if line_type not in ALLOWED_LINE_TYPES:
        line_type = "Solid"
    interpolation = _text(tag.get("interpolation", "Inherit"))
    if interpolation not in ALLOWED_INTERPOLATIONS:
        interpolation = "Inherit"
    axis = _safe_text(tag.get("axis", "axis-primary"), 120, "Tag axis", True)
    return {
        "id": _safe_text(tag.get("id", str(UUID.randomUUID())), 120, "Tag id", False),
        "name": _safe_text(tag.get("name", "Select a historian tag"), MAX_TAG_LABEL_LENGTH, "Tag label", True),
        "path": path,
        "type": _safe_text(tag.get("type", "Float"), 80, "Tag data type", True),
        "source": path,
        "axis": axis,
        "color": _safe_text(tag.get("color", "#75b7ff"), 32, "Tag color", True),
        "width": max(1, min(4, _as_int(tag.get("width", 2), 2))),
        "mode": mode,
        "lineType": line_type,
        "visible": _as_bool(tag.get("visible", True)),
        "aggregate": aggregate,
        "interpolation": interpolation,
        "breakOnMissingData": _as_bool(tag.get("breakOnMissingData", True))
    }

def _normal_range(value):
    text = _text(value).strip()
    if not text or text.lower() == "auto":
        return "Auto"
    number = _as_float(text, None)
    if number is None:
        raise DashboardError("Axis range must be Auto or a number.")
    return str(number)

def _normalize_axis(axis, existing_ids):
    axis = _require_dict(axis or {}, "Axis")
    axis_id = _safe_text(axis.get("id", str(UUID.randomUUID())), 120, "Axis id", False)
    if axis_id in existing_ids:
        raise DashboardError("Trend axis ids must be unique.")
    existing_ids.add(axis_id)
    side = _text(axis.get("side", "Left"))
    if side not in ("Left", "Right"):
        raise DashboardError("Axis position must be Left or Right.")
    data_format = _text(axis.get("dataFormat", "Auto"))
    if data_format not in ALLOWED_DATA_FORMATS:
        raise DashboardError("Axis data format is not supported.")
    minimum = _normal_range(axis.get("min", "Auto"))
    maximum = _normal_range(axis.get("max", "Auto"))
    if minimum != "Auto" and maximum != "Auto" and _as_float(minimum) >= _as_float(maximum):
        raise DashboardError("Axis minimum must be lower than axis maximum.")
    label = _safe_text(axis.get("label", axis.get("name", "Axis")), 160, "Axis label", False)
    return {
        "id": axis_id,
        "label": label,
        "name": label,
        "type": _safe_text(axis.get("type", "Analog"), 80, "Axis type", True),
        "dataFormat": data_format,
        "side": side,
        "offset": max(0, _as_int(axis.get("offset", 0), 0)),
        "width": max(26, min(260, _as_int(axis.get("width", 58), 58))),
        "min": minimum,
        "max": maximum,
        "units": _safe_text(axis.get("units", ""), 40, "Axis units", True),
        "precision": max(0, min(5, _as_int(axis.get("precision", 1), 1))),
        "color": _safe_text(axis.get("color", "#75b7ff"), 32, "Axis color", True),
        "visible": _as_bool(axis.get("visible", True))
    }

def _normalize_widget(widget):
    widget = _require_dict(widget, "Widget")
    widget_type = _text(widget.get("type"))
    if widget_type not in ALLOWED_WIDGET_TYPES:
        raise DashboardError("Unsupported widget type.")
    x = _as_int(widget.get("x"), -1)
    y = _as_int(widget.get("y"), -1)
    width = _as_int(widget.get("w"), 0)
    height = _as_int(widget.get("h"), 0)
    if x < 0 or y < 0 or width < 1 or height < 1 or x + width > GRID_COLUMNS or y + height > GRID_ROWS:
        raise DashboardError("A widget is outside the %s x %s dashboard grid." % (GRID_COLUMNS, GRID_ROWS))

    config = _require_dict(widget.get("config", {}), "Widget config")
    normalized = {
        "id": _safe_text(widget.get("id", str(UUID.randomUUID())), 120, "Widget id", False),
        "type": widget_type,
        "title": _safe_text(widget.get("title", widget_type), MAX_WIDGET_TITLE_LENGTH, "Widget title", False),
        "x": x, "y": y, "w": width, "h": height,
        "showHeader": _as_bool(widget.get("showHeader", True)),
        "contentScale": max(1, min(10, _as_int(widget.get("contentScale", 5), 5))),
        "config": {}
    }

    if widget_type == "trend":
        axes_source = _require_list(config.get("axes", []), "Trend axes")
        if not axes_source:
            axes_source = [_default_axis()]
        if len(axes_source) > MAX_AXES_PER_TREND:
            raise DashboardError("A Trend Chart cannot have more than %s axes." % MAX_AXES_PER_TREND)
        axis_ids = set()
        axes = [_normalize_axis(axis, axis_ids) for axis in axes_source]
        tags_source = _require_list(config.get("tags", []), "Trend tags")
        if len(tags_source) > MAX_TAGS_BY_WIDGET["trend"]:
            raise DashboardError("A Trend Chart cannot have more than %s pens." % MAX_TAGS_BY_WIDGET["trend"])
        tags = [_normalize_tag(tag) for tag in tags_source]
        for tag in tags:
            if tag["path"] and tag["axis"] not in axis_ids:
                tag["axis"] = axes[0]["id"]
        style = _require_dict(config.get("style", {}), "Trend style")
        normalized["config"] = {
            "axes": axes,
            "tags": tags,
            "style": {
                "showLegend": _as_bool(style.get("showLegend", True)),
                "showGrid": _as_bool(style.get("showGrid", True)),
                "background": _safe_text(style.get("background", "Default dark"), 40, "Trend background", True),
                "interpolation": "Smooth" if _text(style.get("interpolation")) == "Smooth" else "Linear",
                "referenceLineStyle": "Transparent" if _text(style.get("referenceLineStyle")) == "Transparent" else "Solid"
            },
            "timeScope": "Dashboard"
        }
    elif widget_type in ("table", "events"):
        tags_source = _require_list(config.get("tags", []), "Widget tags")
        limit = MAX_TAGS_BY_WIDGET[widget_type]
        if len(tags_source) > limit:
            raise DashboardError("%s cannot have more than %s tags." % (widget_type, limit))
        normalized["config"] = {
            "tags": [_normalize_tag(tag) for tag in tags_source],
            "maxRows": max(1, min(100, _as_int(config.get("maxRows", 5), 5))),
            "timeScope": "Dashboard"
        }
    else:
        tag = _normalize_tag(config.get("tag", {}))
        widget_config = {
            "tag": tag,
            "timeScope": "Dashboard"
        }
        if widget_type == "value":
            widget_config.update({
                "units": _safe_text(config.get("units", ""), 40, "Value units", True),
                "precision": max(0, min(5, _as_int(config.get("precision", 1), 1))),
                "showDelta": _as_bool(config.get("showDelta", False)),
                "accent": _safe_text(config.get("accent", "#75b7ff"), 32, "Value accent", True)
            })
        elif widget_type == "status":
            widget_config.update({
                "onText": _safe_text(config.get("onText", "On"), 80, "On text", True),
                "offText": _safe_text(config.get("offText", "Off"), 80, "Off text", True),
                "trueColor": _safe_text(config.get("trueColor", "#4fd1a5"), 32, "True color", True),
                "falseColor": _safe_text(config.get("falseColor", "#fb7185"), 32, "False color", True)
            })
        elif widget_type in ("timeline", "statebreakdown"):
            widget_config["stateLabels"] = _to_plain(config.get("stateLabels", {}))
        elif widget_type == "stat":
            metric = _text(config.get("metric", "Average"))
            if metric not in ALLOWED_STAT_METRICS:
                raise DashboardError("Range Statistic metric is not supported.")
            widget_config.update({
                "metric": metric,
                "stateValue": _as_int(config.get("stateValue", 0), 0),
                "units": _safe_text(config.get("units", ""), 40, "Statistic units", True),
                "precision": max(0, min(5, _as_int(config.get("precision", 1), 1))),
                "accent": _safe_text(config.get("accent", "#75b7ff"), 32, "Statistic accent", True)
            })
        normalized["config"] = widget_config
    return normalized

def _widgets_overlap(a, b):
    return a["x"] < b["x"] + b["w"] and a["x"] + a["w"] > b["x"] and a["y"] < b["y"] + b["h"] and a["y"] + a["h"] > b["y"]

def _validate_dashboard_config(config, allow_empty_widgets=False):
    config = _require_dict(config, "Dashboard config")
    rows = _as_int(config.get("rows", GRID_ROWS), GRID_ROWS)
    cols = _as_int(config.get("cols", GRID_COLUMNS), GRID_COLUMNS)
    if rows != GRID_ROWS or cols != GRID_COLUMNS:
        raise DashboardError("Dashboard grid must remain %s columns by %s rows." % (GRID_COLUMNS, GRID_ROWS))
    widgets_source = _require_list(config.get("widgets", []), "Widgets")
    if not widgets_source and not allow_empty_widgets:
        raise DashboardError("A dashboard must contain at least one widget.")
    if len(widgets_source) > MAX_WIDGETS_PER_DASHBOARD:
        raise DashboardError("Dashboard exceeds the %s-widget limit." % MAX_WIDGETS_PER_DASHBOARD)

    widgets = []
    widget_ids = set()
    for widget in widgets_source:
        normalized = _normalize_widget(widget)
        if normalized["id"] in widget_ids:
            raise DashboardError("Widget ids must be unique.")
        widget_ids.add(normalized["id"])
        for existing in widgets:
            if _widgets_overlap(normalized, existing):
                raise DashboardError("Dashboard widgets may not overlap.")
        widgets.append(normalized)

    return {
        "rows": GRID_ROWS,
        "cols": GRID_COLUMNS,
        "openingLiveRange": _validate_opening_range(config.get("openingLiveRange", {})),
        "widgets": widgets
    }

def _config_json(config):
    text = json.dumps(config, separators=(",", ":"), ensure_ascii=False)
    if len(text.encode("utf-8")) > MAX_JSON_REQUEST_BYTES:
        raise DashboardError("Dashboard configuration is too large.")
    return text

