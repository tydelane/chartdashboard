olor:#86b9eb}\n.dashboard-canvas:not(.editing) .dashboard-tile{border-color:#395f8e}\n.dashboard-canvas:not(.editing) .dashboard-tile:hover{border-color:#5b92cb}\n.fullscreen-mode-badge{\n  flex:0 0 auto;\n  padding:4px 6px;\n  border:1px solid #5c91c8;\n  border-radius:6px;\n  color:#cce6ff;\n  font-size:8px;\n  font-weight:900;\n  letter-spacing:.09em;\n}\n\n\n/* v4 interaction refinements */\n.axis-row.axis-hidden{\n  border-style:dashed;\n  opacity:.72;\n  background:rgba(11,18,32,.42);\n}\n.axis-hidden-note{\n  margin-top:8px;\n  padding:7px 8px;\n  border:1px dashed #53667f;\n  border-radius:7px;\n  color:#a7b6c9;\n  background:rgba(13,22,39,.42);\n  font-size:10px;\n  line-height:1.4;\n}\n.axis-visibility-badge{\n  display:inline-block;\n  margin-top:3px;\n  padding:2px 5px;\n  border-radius:999px;\n  background:#284e78;\n  color:#cfe6ff;\n  font-size:8px;\n  letter-spacing:.08em;\n  font-weight:900;\n  text-transform:uppercase;\n}\n.axis-visibility-badge.hidden{\n  background:#45495a;\n  color:#d1d7e0;\n}\n.time-mode-empty{\n  height:100%;\n  padding:14px;\n  display:flex;\n  flex-direction:column;\n  justify-content:center;\n  align-items:flex-start;\n  color:#cbd9ea;\n  background:\n    linear-gradient(135deg,rgba(38,62,90,.32),rgba(16,27,45,.55)),\n    repeating-linear-gradient(-45deg,rgba(128,162,201,.05),rgba(128,162,201,.05) 8px,transparent 8px,transparent 16px);\n}\n.time-mode-empty strong{\n  color:#f1f7ff;\n  font-size:12px;\n  margin-bottom:4px;\n}\n.time-mode-empty span{\n  color:#9eb2cd;\n  font-size:10px;\n  line-height:1.45;\n}\n.tile-compat{\n  display:inline-block;\n  margin-left:4px;\n  padding:2px 4px;\n  border:1px solid #3e668e;\n  border-radius:4px;\n  color:#9fc9f0;\n  font-size:7px;\n  letter-spacing:.08em;\n  font-weight:900;\n}\n.tile-compat.live{\n  border-color:#5d7252;\n  color:#b8de9d;\n}\n.confirm-message{\n  color:#c6d4e8;\n  font-size:12px;\n  line-height:1.55;\n}\n.confirm-message strong{color:#f3f8ff}\n.confirm-warning{\n  margin-top:11px;\n  padding:9px 10px;\n  border:1px solid #865351;\n  border-radius:8px;\n  background:rgba(112,46,46,.18);\n  color:#ffd1d1;\n  font-size:11px;\n}\n\n\n\n/* Saved per-widget display scale. The grid footprint stays the same. */\n.widget-scale-layer{\n  position:absolute;\n  left:0;\n  top:0;\n  overflow:hidden;\n  transform-origin:top left;\n  transform:scale(var(--widget-content-scale));\n}\n.dashboard-tile .resize-handle{z-index:5}\n.widget-scale-note{\n  margin-top:9px;\n  padding:8px 9px;\n  border:1px solid #465e80;\n  border-radius:8px;\n  background:rgba(25,43,71,.48);\n  color:#bed1e8;\n  font-size:10px;\n  line-height:1.43;\n}\n.widget-scale-note b{color:#f0f6ff}\n\n\n/* Edit-mode clarity */\n.btn.edit-unlocked{\n  color:#fff7dc;\n  border-color:#d7a64f;\n  background:linear-gradient(180deg,#80601d,#4f3a14);\n}\n.editor-lock-note{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:9px;\n  margin:0 0 10px;\n  padding:9px 10px;\n  border:1px solid #5c536b;\n  border-radius:9px;\n  background:rgba(55,46,70,.42);\n  color:#c4b7d1;\n  font-size:10.5px;\n  line-height:1.4;\n}\n.editor-lock-note b{color:#eee4f6}\n.editor-lock-note .btn{flex:0 0 auto}\n\n\n/* Linked-dashboard time context */\n.focus-reference{\n  display:inline-flex;\n  align-items:center;\n  gap:6px;\n  padding:5px 8px;\n  border:1px solid #554055;\n  border-radius:8px;\n  background:rgba(59,37,55,.30);\n  color:#dfc7db;\n  font-size:10px;\n  font-weight:760;\n}\n.focus-reference .focus-dot{\n  width:7px;\n  height:7px;\n  border-radius:50%;\n  background:#fb5b6e;\n  box-shadow:0 0 0 4px rgba(251,91,110,.11);\n}\n.focus-reference.current{\n  border-color:#3d6e5b;\n  background:rgba(31,75,57,.22);\n  color:#c7efd8;\n}\n.focus-reference.current .focus-dot{\n  background:#4fd1a5;\n  box-shadow:0 0 0 4px rgba(79,209,165,.11);\n}\n.focus-reference.inspect{\n  border-color:#8e515d;\n  background:rgba(90,39,48,.23);\n  color:#ffd2d8;\n}\n\n\n/* Session-only controls that live directly on Trend Chart widgets. */\n.tile-body{position:relative}\n.trend-session-toolbar{\n  position:absolute;\n  top:7px;\n  right:7px;\n  z-index:25;\n  display:flex;\n  align-items:center;\n  gap:5px;\n  padding:3px;\n  border:1px solid rgba(76,105,142,.86);\n  border-radius:8px;\n  background:rgba(11,21,38,.84);\n  box-shadow:0 6px 16px rgba(0,0,0,.28);\n  backdrop-filter:blur(8px);\n}\n.trend-session-control{\n  min-height:24px;\n  padding:0 7px;\n  border:1px solid transparent;\n  border-radius:5px;\n  background:transparent;\n  color:#b9cbe3;\n  font-size:9px;\n  font-weight:850;\n  white-space:nowrap;\n}\n.trend-session-control:hover{\n  border-color:#6b9dd4;\n  background:#1e3558;\n  color:#f2f8ff;\n}\n.trend-session-control.on{\n  border-color:#4b9a86;\n  background:#163f36;\n  color:#bdf3dc;\n}\n.trend-session-control.reset{\n  color:#ffd6da;\n}\n.trend-session-control.reset:hover{\n  border-color:#b96a75;\n  background:#47222b;\n  color:#fff1f2;\n}\n\n\n/* ===================================================================\n   VIEW MODE / EDIT MODE\n   View mode contains only the dashboard and its data controls.\n   The editor toolbar and configuration panel are created for editing,\n   not for the normal dashboard experience.\n   =================================================================== */\n#app.view-mode #dashboardEditorToolbar,\n#app.view-mode #dashboardInspector,\n#app.view-mode .editor-only{\n  display:none!important;\n}\n#app.view-mode #contentGrid{grid-template-columns:minmax(0,1fr)}\n#app.view-mode .title-input{\n  pointer-events:none;\n  border-color:transparent;\n  background:transparent;\n  box-shadow:none;\n  padding-left:0;\n}\n#app.view-mode .title-input:focus{outline:none}\n#app.view-mode .dashboard-tile{cursor:default}\n#app.view-mode .dashboard-tile.selected{box-shadow:none;border-color:var(--stroke)}\n#app.edit-mode .dashboard-zone-header{\n  border-color:#5a87bd;\n  background:linear-gradient(90deg,rgba(51,104,168,.22),rgba(23,34,60,.38));\n}\n\n\n/* Global time controls are now part of the compact dashboard control bar. */\n.editor-column{\n  align-self:start;\n  position:sticky;\n  top:15px;\n  max-height:calc(100vh - 30px);\n  overflow:auto;\n  display:flex;\n  flex-direction:column;\n  gap:12px;\n  min-width:0;\n  padding-right:2px;\n}\n#dashboardEditorToolbar{\n  flex-direction:column;\n  align-items:stretch;\n  gap:7px;\n}\n#dashboardEditorToolbar .toolbar-scope{margin-bottom:2px}\n#dashboardEditorToolbar .toolbar-note{margin-left:0;line-height:1.4}\n#dashboardEditorToolbar .btn{text-align:left}\n#dashboardInspector{position:static;max-height:none;overflow:visible}\n#app.view-mode #editorColumn{display:none!important}\n#app.view-mode #contentGrid{grid-template-columns:minmax(0,1fr)}\n@media(max-width:1120px){\n  .global-data-zone{position:static}\n  .editor-column{position:static;max-height:none;overflow:visible}\n}\n\n@media(max-width:1120px){\n  .content-grid{grid-template-columns:1fr}\n  .inspector{position:static;max-height:none}\n  .dashboard-canvas{height:620px}\n}\n\n@media(max-width:780px){\n  .dashboard-zone-footer{display:block;line-height:1.55}\n  .dashboard-zone-footer span{display:block}\n  .dashboard-zone-header{padding:9px 10px}\n  .zone-heading{font-size:12px}\n  .toolbar-scope em{display:none}\n  .global-zone-strip{display:block;line-height:1.5}\n  .global-zone-strip span{display:block}\n}\n\n@media(max-width:780px){\n  .app-shell{display:block;height:auto;min-height:100vh;overflow:visible}\n  .sidebar{position:fixed;left:0;top:0;z-index:40;box-shadow:20px 0 45px rgba(0,0,0,.48)}\n  .app-shell:not(.sidebar-mobile-open) .sidebar{transform:translateX(-278px);opacity:0;pointer-events:none}\n  .workspace{min-height:100vh;overflow:visible}\n  .main{overflow:visible;padding:12px}\n  .topbar{padding:0 11px}\n  .hide-mobile{display:none}\n  .dashboard-canvas{height:540px}\n  .input.datetime{min-width:140px}\n  .widget-gallery{grid-template-columns:1fr}\n  .browser-grid{grid-template-columns:1fr}\n}\n\n/* ==========================================================================\n   COMPACT DASHBOARD CONTROL BAR\n   One horizontal command/data bar sits directly above the saved dashboard.\n   It intentionally does not stick to the page: scrolling never covers tiles.\n   Narrow screens keep controls in one line and scroll horizontally rather\n   than stacking controls vertically.\n   ========================================================================== */\n.dashboard-control-bar{\n  position:static!important;\n  z-index:auto!important;\n  margin:0 0 10px!important;\n  padding:8px 10px!important;\n  overflow:hidden;\n  border-color:#496541!important;\n  background:linear-gradient(180deg,rgba(35,55,37,.96),rgba(18,31,29,.96))!important;\n  box-shadow:0 8px 20px rgba(4,9,20,.18), inset 3px 0 0 rgba(127,169,102,.42)!important;\n}\n.control-bar-scroll{\n  display:flex;\n  align-items:center;\n  gap:9px;\n  min-width:0;\n  overflow-x:auto;\n  overflow-y:hidden;\n  white-space:nowrap;\n  scrollbar-width:thin;\n  scrollbar-color:#55756b transparent;\n  padding-bottom:1px;\n}\n.control-bar-scroll::-webkit-scrollbar{height:5px}\n.control-bar-scroll::-webkit-scrollbar-thumb{background:#55756b;border-radius:999px}\n.control-group{\n  display:flex;\n  align-items:center;\n  gap:7px;\n  flex:0 0 auto;\n  min-width:max-content;\n}\n.control-group.command-group{gap:6px}\n.control-group.context-group{gap:6px}\n.control-bar-divider{\n  flex:0 0 auto;\n  width:1px;\n  height:27px;\n  background:#4b6744;\n}\n.dashboard-control-bar .icon-btn{\n  width:31px;\n  height:31px;\n  border-radius:8px;\n}\n.dashboard-control-bar .btn,\n.dashboard-control-bar .mode-pill{\n  min-height:31px;\n}\n.dashboard-control-bar .btn{\n  padding:0 9px;\n  border-radius:8px;\n  font-size:11px;\n}\n.dashboard-control-bar .mode-pills{\n  padding:2px;\n  border-radius:8px;\n}\n.dashboard-control-bar .mode-pill{\n  padding:5px 8px;\n  font-size:10.5px;\n}\n.dashboard-control-bar .input,\n.dashboard-control-bar .select{\n  min-height:31px;\n  border-radius:7px;\n  font-size:11px;\n}\n.dashboard-control-bar .input.amount{width:51px;padding:0 6px}\n.dashboard-control-bar .input.datetime{min-width:156px}\n.dashboard-control-bar .field-label{font-size:10px}\n.dashboard-control-bar .time-controls{\n  display:flex;\n  align-items:center;\n  gap:6px;\n  flex-wrap:nowrap;\n  margin:0;\n}\n.dashboard-control-bar .divider{\n  height:21px;\n  margin:0 1px;\n}\n.dashboard-control-bar .live-indicator{\n  font-size:10px;\n}\n.dashboard-control-bar .focus-reference{\n  padding:4px 7px;\n  border-radius:7px;\n  font-size:9.5px;\n}\n.dashboard-control-bar .pulse{width:6px;height:6px}\n.compact-title-wrap{\n  display:flex;\n  align-items:center;\n  min-width:170px;\n  max-width:275px;\n}\n.dashboard-control-bar .title-input{\n  width:100%;\n  padding:3px 4px;\n  color:#f2f8ff;\n  font-size:13px;\n  line-height:1.2;\n}\n.dashboard-control-bar .status{\n  padding:4px 6px;\n  border-radius:7px;\n  font-size:10px;\n}\n.dashboard-control-bar .subtitle{display:none}\n.dashboard-control-bar .history-controls{display:flex}\n#app.view-mode .dashboard-control-bar .editor-only{display:none!important}\n#app.view-mode #contentGrid{grid-template-columns:minmax(0,1fr)}\n.main{padding-top:10px}\n.dashboard-canvas{\n  height:clamp(525px,calc(100vh - 166px),820px);\n}\n@media(max-width:1120px){\n  .dashboard-control-bar{position:static!important}\n  .dashboard-canvas{height:clamp(510px,calc(100vh - 148px),760px)}\n}\n@media(max-width:780px){\n  .dashboard-control-bar{margin-bottom:8px!important;padding:7px 8px!important}\n  .dashboard-control-bar .input.datetime{min-width:142px}\n  .dashboard-canvas{height:525px}\n}\n\n/* ==========================================================================\n   V14 — CLEARLY SEPARATED TIME AND DASHBOARD ACTION ZONES\n   The bar uses three lanes. The time lane may scroll horizontally; navigation\n   and dashboard actions remain fixed at the left and right edges.\n   ========================================================================== */\n.dashboard-control-bar{\n  overflow:hidden!important;\n  padding:7px 8px!important;\n}\n.control-bar-layout{\n  display:grid;\n  grid-template-columns:auto minmax(0,1fr) auto;\n  align-items:center;\n  gap:8px;\n  min-width:0;\n}\n.control-bar-left,\n.control-bar-actions{\n  display:flex;\n  align-items:center;\n  gap:6px;\n  flex:0 0 auto;\n  min-width:max-content;\n}\n.control-bar-left{\n  padding-right:8px;\n  border-right:1px solid #4b6744;\n}\n.control-bar-time-lane{\n  min-width:0;\n  overflow:hidden;\n  padding:3px 0;\n}\n.control-bar-time-scroll{\n  display:flex;\n  align-items:center;\n  gap:7px;\n  overflow-x:auto;\n  overflow-y:hidden;\n  white-space:nowrap;\n  scrollbar-width:thin;\n  scrollbar-color:#547c7a transparent;\n  padding:1px 2px 4px;\n}\n.control-bar-time-scroll::-webkit-scrollbar{height:5px}\n.control-bar-time-scroll::-webkit-scrollbar-thumb{background:#547c7a;border-radius:999px}\n.time-zone-shell{\n  display:flex;\n  align-items:center;\n  gap:7px;\n  flex:0 0 auto;\n  min-width:max-content;\n  padding:3px 5px 3px 6px;\n  border:1px solid #416d6b;\n  border-radius:10px;\n  background:linear-gradient(180deg,rgba(30,74,70,.50),rgba(18,49,48,.44));\n}\n.time-zone-label{\n  display:inline-flex;\n  align-items:center;\n  gap:4px;\n  padding:0 4px 0 1px;\n  color:#a9d7d0;\n  font-size:9px;\n  font-weight:900;\n  letter-spacing:.10em;\n  text-transform:uppercase;\n}\n.time-zone-label span{\n  color:#6dd4c0;\n  font-size:12px;\n  line-height:1;\n}\n.control-bar-actions{\n  padding:3px 4px 3px 7px;\n  border:1px solid #707052;\n  border-radius:10px;\n  background:linear-gradient(180deg,rgba(86,75,40,.42),rgba(48,43,27,.44));\n  box-shadow:inset 0 1px 0 rgba(255,240,172,.08);\n}\n.dashboard-zone-label{\n  display:inline-flex;\n  align-items:center;\n  gap:4px;\n  padding-right:4px;\n  color:#e4d59e;\n  font-size:9px;\n  font-weight:900;\n  letter-spacing:.10em;\n  text-transform:uppercase;\n}\n.dashboard-zone-label span{\n  color:#f1c665;\n  font-size:12px;\n  line-height:1;\n}\n.control-bar-actions .status{\n  border-color:#486a50;\n  background:rgba(25,74,49,.44);\n  color:#beebce;\n}\n.control-bar-actions #editModeBtn{\n  border-color:#637eaa;\n}\n.control-bar-actions #fullscreenBtn{\n  border-color:#356e67;\n  background:linear-gradient(180deg,#1f625a,#174840);\n  color:#e9fffa;\n}\n.dashboard-control-bar .compact-title-wrap{min-width:155px;max-width:235px}\n.dashboard-control-bar .compact-title-wrap .title-input{font-size:12.5px}\n.control-bar-time-scroll .mode-pills{flex:0 0 auto}\n.control-bar-time-scroll .time-controls{flex:0 0 auto}\n@media(max-width:1180px){\n  .dashboard-zone-label{display:none}\n  .dashboard-control-bar .compact-title-wrap{max-width:180px;min-width:125px}\n}\n@media(max-width:900px){\n  .control-bar-layout{gap:6px}\n  .control-bar-left{padding-right:6px}\n  .dashboard-control-bar .compact-title-wrap{display:none}\n  .dashboard-zone-label{display:none}\n  .control-bar-actions{padding-left:5px}\n  .control-bar-actions .btn{padding:0 7px}\n}\n@media(max-width:680px){\n  .control-bar-left{border-right:0;padding-right:0}\n  .control-bar-actions{gap:4px}\n  .control-bar-actions .status{display:none}\n  .dashboard-control-bar #fullscreenBtn{display:none}\n  .dashboard-control-bar #editModeBtn{padding:0 7px}\n}\n\n.tag-change-note{\n  margin-top:9px;\n  padding:8px 9px;\n  border:1px solid #3f5c80;\n  border-radius:8px;\n  background:rgba(21,44,77,.35);\n  color:#b9cde6;\n  font-size:10px;\n  line-height:1.42;\n}\n\n\n/* ===== V18 CONFIGURATION CONTROLS ======================================\n   Saved per-pen missing-data behavior uses an explicit checkbox so its\n   meaning remains obvious: checked = visibly break the line at a data gap. */\n.pen-break-check{\n  display:flex;\n  align-items:center;\n  gap:6px;\n  min-height:29px;\n  padding:5px 7px;\n  border:1px solid #3a5477;\n  border-radius:7px;\n  background:rgba(17,35,62,.48);\n  color:#c8d9ee;\n  font-size:10px;\n  line-height:1.25;\n  cursor:pointer;\n}\n.pen-break-check input{accent-color:#75b7ff}\n.pen-break-check input:disabled{cursor:not-allowed}\n.query-limit-badge{\n  display:inline-flex;\n  align-items:center;\n  min-height:24px;\n  padding:0 7px;\n  border:1px solid #75683e;\n  border-radius:7px;\n  background:rgba(99,79,29,.28);\n  color:#f2d98b;\n  font-size:9.5px;\n  font-weight:800;\n  letter-spacing:.02em;\n}\n\n/* Saved dashboard opening range is distinct from temporary global controls. */\n.opening-range-note{\n  margin-top:10px;\n  padding:9px 10px;\n  border:1px solid #4d6957;\n  border-radius:8px;\n  background:rgba(28,58,43,.28);\n  color:#cae7d2;\n  font-size:10px;\n  line-height:1.45;\n}\n</style>\n</head>\n<body>\n<div id="app" class="app-shell view-mode">\n  <aside class="sidebar">\n    <div class="brand">\n      <div class="brand-row">\n        <div class="brand-mark">MON</div>\n        <div><h1>MON- Plant Metrics Dashboard</h1><p>Read-only process and historian dashboards</p></div>\n      </div>\n    </div>\n    <div class="side-actions">\n      <button id="newDashboardBtn" class="btn primary" title="Save the current dashboard, then create a new private dashboard in View mode">＋ New dashboard</button>\n      <button id="browseSharedBtn" class="btn" title="Browse shared dashboards and copy one into your own list">Browse shared</button>\n    </div>\n    <div class="side-heading">My dashboards <span id="dashboardCount" class="count"></span></div>\n    <div id="dashboardList" class="dashboard-list"></div>\n    <div class="side-footer">\n      <div class="user-card"><div id="sessionAvatar" class="avatar">?</div><div><div id="sessionUsername" class="user-name">Loading user…</div><div class="user-role">Authenticated Ignition session</div></div></div>\n    </div>\n  </aside>\n\n  <section class="workspace">\n    <main class="main">\n      <section class="card dashboard-control-bar" aria-label="Dashboard and global data controls">\n        <div class="control-bar-layout">\n          <!-- Left: dashboard identity and navigation stay fixed. -->\n          <div class="control-bar-left">\n            <button id="toggleSidebarBtn" class="icon-btn" title="Show or hide the dashboard list">☰</button>\n            <div class="compact-title-wrap">\n              <input id="dashboardTitleInput" class="title-input" value="Loading dashboard…" title="Dashboard name. Editable only in Edit dashboard mode." readonly>\n              <p id="dashboardDescription" class="subtitle">A fixed dashboard canvas with configurable, resizable historian widgets</p>\n            </div>\n          </div>\n\n          <!-- Middle: data/time controls may scroll, but never stack. -->\n          <div class="control-bar-time-lane">\n            <div class="control-bar-time-scroll">\n              <div class="time-zone-shell">\n                <div class="time-zone-label"><span>◷</span>Data</div>\n                <div class="mode-pills">\n                  <button id="liveModeBtn" class="mode-pill active" title="Use a rolling time range that can refresh automatically">Live</button>\n                  <button id="historyModeBtn" class="mode-pill" title="Use a temporary fixed historical range. Dashboard openings always return to the saved Live opening range.">History</button>\n                </div>\n\n                <div id="liveControls" class="time-controls">\n                  <span class="field-label">Last</span>\n                  <input id="rangeAmount" class="input amount" type="number" min="1" max="999" value="8" title="Temporary live viewing range. Configure the saved opening range in Edit dashboard > Dashboard.">\n                  <select id="rangeUnit" class="select" title="Unit for the live time window"><option>Seconds</option><option>Minutes</option><option selected>Hours</option><option>Days</option><option>Weeks</option><option>Months</option></select>\n                  <span class="divider"></span>\n                  <label class="switch-row" style="gap:6px" title="Turn automatic live refresh on or off"><span class="field-label">Auto</span><span id="autoRefreshSwitch" class="switch on"></span></label>\n                  <select id="pollRate" class="select" title="How often live data refreshes while Auto refresh is on"><option value="5">5 sec</option><option value="10" selected>10 sec</option><option value="30">30 sec</option><option value="60">1 min</option></select>\n                  <button id="refreshBtn" class="btn primary" title="Refresh the current live range immediately">Refresh</button>\n                </div>\n\n                <div id="historyControls" class="time-controls hidden history-controls">\n                  <span class="field-label">From</span><input id="startDate" class="input datetime" type="datetime-local" title="Start of the fixed historical range">\n                  <span class="field-label">To</span><input id="endDate" class="input datetime" type="datetime-local" title="End of the fixed historical range">\n                  <button id="loadHistoryBtn" class="btn primary" title="Load the selected fixed historical range">Load</button>\n                </div>\n\n                <div id="focusReference" class="focus-reference current" title="The time reference shared by all synchronized widgets"><span class="focus-dot"></span><span id="focusReferenceText">Reference: latest live value</span></div>\n                <div id="liveStatus" class="live-indicator" title="Shows whether automatic live refresh is active"><span class="pulse"></span>Live</div>\n            <span id="queryLimitBadge" class="query-limit-badge" title="Maximum time span allowed for one historian request">Max 6 mo</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Right: dashboard-level actions are visually separate and pinned. -->\n          <div class="control-bar-actions">\n            <div class="dashboard-zone-label"><span>▣</span>Dashboard</div>\n            <span id="saveStatus" class="status" title="Shows whether the current dashboard configuration is saved">Saved</span>\n            <button id="editModeBtn" class="btn small primary" title="Show or hide the editor, widget configuration, and layout controls">Edit dashboard</button>\n            <button id="fullscreenBtn" class="btn small primary" title="Save this dashboard, leave Edit mode, and show only the dashboard canvas">Fullscreen</button>\n            <button id="shareDashboardBtn" class="btn small share-toggle editor-only" title="Choose whether this dashboard appears in Browse Shared after saving">Shared</button>\n            <button id="duplicateDashboardBtn" class="btn small hide-mobile editor-only" title="Create a private copy of this dashboard">Duplicate</button>\n            <button id="saveDashboardBtn" class="btn small editor-only" title="Save the dashboard layout and configuration">Save</button>\n            <button id="deleteDashboardBtn" class="btn small danger editor-only" title="Delete this dashboard after confirmation">Delete</button>\n          </div>\n        </div>\n      </section>\n\n      <div id="contentGrid" class="content-grid">\n        <div class="left-col">\n\n          <section class="dashboard-zone">\n            <div class="dashboard-zone-header">\n              <div class="dashboard-zone-title">\n                <span class="zone-icon">▦</span>\n                <div>\n                  <div class="zone-eyebrow">Saved dashboard canvas</div>\n                  <div class="zone-heading">This is the dashboard users will see</div>\n                </div>\n              </div>\n              <div id="dashboardViewModePill" class="dashboard-mode-pill">VIEW MODE</div>\n            </div>\n\n            <section id="dashboardStage" class="dashboard-stage">\n              <div id="fullscreenNav" class="fullscreen-nav">\n                <button id="exitFullscreenBtn" class="btn small danger fullscreen-exit" title="Return to the dashboard workspace">Exit fullscreen</button>\n                <span class="fullscreen-mode-badge">DASHBOARD VIEW</span>\n                <div id="fullscreenCarousel" class="carousel-strip"></div>\n                <span class="fullscreen-label">Dashboards</span>\n              </div>\n              <div id="dashboardCanvas" class="dashboard-canvas"></div>\n            </section>\n\n            <div class="dashboard-zone-footer">\n              <span>Only the tiles inside this blue 24 × 16 grid are part of the saved dashboard. Hidden axes do not consume chart-edge space.</span>\n              <span>Fullscreen shows this canvas only.</span>\n            </div>\n          </section>\n\n        </div>\n\n        <div id="editorColumn" class="editor-column">\n          <div id="dashboardEditorToolbar" class="dashboard-toolbar">\n            <div class="toolbar-scope"><span>✦</span><b>Dashboard editor</b><em>changes stay local until you save</em></div>\n            <button id="addWidgetBtn" class="btn small primary" title="Add a new dashboard widget">＋ Add widget</button>\n            <button id="duplicateWidgetBtn" class="btn small" title="Duplicate the selected widget">Duplicate selected</button>\n            <button id="deleteWidgetBtn" class="btn small danger" title="Delete the selected widget after confirmation">Delete selected</button>\n            <button id="fitLayoutBtn" class="btn small" title="Restore the default layout after confirmation">Reset layout</button>\n            <span id="toolbarHint" class="toolbar-note">Select a widget to configure it, then drag or resize it on the grid.</span>\n          </div>\n\n        <aside id="dashboardInspector" class="card inspector">\n          <div class="config-panel-identity">\n            <span class="config-panel-icon">⚙</span>\n            <div>\n              <div class="config-panel-eyebrow">Configuration panel</div>\n              <div class="config-panel-copy">Editor controls only — never displayed as a dashboard tile</div>\n            </div>\n          </div>\n          <div class="tabs">\n            <button class="tab active" data-tab="dashboard" title="Configure how this dashboard opens for every user session">Dashboard</button>\n            <button class="tab" data-tab="widget" title="Configure the selected widget’s size, location, and behavior">Widget</button>\n            <button class="tab" data-tab="tags" title="Choose historian tags and pen settings for the selected widget">Tags</button>\n            <button class="tab" data-tab="axes" title="Configure Trend Chart axes and fixed operating ranges">Axes</button>\n            <button class="tab" data-tab="style" title="Configure saved visual settings for the selected widget">Style</button>\n          </div>\n          <div id="tab-dashboard" class="panel-body"></div>\n          <div id="tab-widget" class="panel-body hidden"></div>\n          <div id="tab-tags" class="panel-body hidden"></div>\n          <div id="tab-axes" class="panel-body hidden"></div>\n          <div id="tab-style" class="panel-body hidden"></div>\n        </aside>\n        </div>\n      </div>\n    </main>\n  </section>\n</div>\n\n<div id="widgetModal" class="modal-backdrop">\n  <div class="modal small">\n    <div class="modal-head"><div><h3 class="modal-title">Add a dashboard widget</h3><div class="card-sub">A focused set of read-only process visuals — no clutter.</div></div><button class="icon-btn close-modal">×</button></div>\n    <div class="modal-body"><div id="widgetGallery" class="widget-gallery"></div></div>\n  </div>\n</div>\n\n<div id="tagBrowserModal" class="modal-backdrop">\n  <div class="modal">\n    <div class="modal-head"><div><h3 id="tagBrowserTitle" class="modal-title">Add Historian Tag</h3><div id="tagBrowserSubtitle" class="card-sub">Browse approved read-only tag roots.</div></div><button class="icon-btn close-modal" title="Close tag browser">×</button></div>\n    <div class="modal-body browser-grid">\n      <div id="tagTree" class="tree"><div class="empty">Loading approved tag roots…</div></div>\n      <div class="tag-preview">\n        <div class="field-label">Selected path</div>\n        <div id="selectedTagPath" class="tag-path">Choose an approved historian tag</div>\n        <div class="prop-grid">\n          <div class="prop"><label>Display name</label><input id="selectedTagName" class="input" value=""></div>\n          <div class="prop"><label>Detected type</label><input id="selectedTagType" class="input" value="" readonly></div>\n          <div class="prop"><label>Suggested render mode</label><select id="selectedTagMode" class="select"><option>Analog line</option><option>Digital step line</option><option>State step line</option></select></div>\n          <div id="selectedTagAxisProp" class="prop"><label>Assign to trend axis</label><select id="selectedTagAxis" class="select"></select></div>\n        </div>\n        <div id="tagBrowserContextNote" style="margin-top:16px;color:var(--muted);font-size:11px;line-height:1.5">Requested paths are validated on the server against configured allowed roots before browsing or querying history.</div>\n      </div>\n    </div>\n    <div class="modal-foot"><button class="btn close-modal">Cancel</button><button id="addSelectedTagBtn" class="btn primary">Add selected tag</button></div>\n  </div>\n</div>\n\n<div id="sharedModal" class="modal-backdrop">\n  <div class="modal small">\n    <div class="modal-head"><div><h3 class="modal-title">Browse Shared Dashboards</h3><div class="card-sub">Copy a useful layout into your own dashboard list.</div></div><button class="icon-btn close-modal">×</button></div>\n    <div id="sharedList" class="modal-body"></div>\n  </div>\n</div>\n\n<div id="confirmModal" class="modal-backdrop">\n  <div class="modal small">\n    <div class="modal-head">\n      <div>\n        <h3 id="confirmTitle" class="modal-title">Confirm action</h3>\n        <div id="confirmSubtitle" class="card-sub">This changes the saved dashboard configuration.</div>\n      </div>\n      <button id="confirmClose" class="icon-btn">×</button>\n    </div>\n    <div id="confirmMessage" class="modal-body confirm-message"></div>\n    <div class="modal-foot">\n      <button id="confirmCancel" class="btn">Cancel</button>\n      <button id="confirmProceed" class="btn danger">Continue</button>\n    </div>\n  </div>\n</div>\n\n<div id="toast" class="toast"></div>\n\n<script>\n(function(){\n  // Server-injected deployment paths and client-visible limits. The Python\n  // Project Library module owns the values; the browser never supplies them.\n  window.PMD_CONFIG=__PMD_CLIENT_CONFIG__;\n\n  // Production uses the locally hosted Apache ECharts File Resource only.\n  // There is intentionally no CDN fallback, so this application never needs\n  // internet access and does not silently load an unreviewed remote library.\n  function localScriptThenCdn(done){\n    var local=document.createElement(\'script\');\n    local.src=window.PMD_CONFIG.echartsAssetPath;\n    local.onload=done;\n    local.onerror=function(){\n      document.getElementById(\'dashboardCanvas\').innerHTML=\'<div class="empty"><b>Apache ECharts did not load.</b><br>Verify ECHARTS_ASSET_PATH in the Web Dev deployment constants and confirm the local File Resource exists.</div>\';\n    };\n    document.head.appendChild(local);\n  }\n\n  // ===== BASIC UTILITIES ===============================================\n  // Small dependency-free helpers keep this single-file dashboard readable.\n  var $=function(id){return document.getElementById(id);};\n  function uid(prefix){return prefix+\'-\'+Math.random().toString(36).slice(2,10);}\n  function clone(obj){return JSON.parse(JSON.stringify(obj));}\n  function esc(s){return String(s||\'\').replace(/[&<>"\']/g,function(c){return {\'&\':\'&amp;\',\'<\':\'&lt;\',\'>\':\'&gt;\',\'"\':\'&quot;\',"\'":\'&#039;\'}[c];});}\n  function clamp(n,min,max){return Math.max(min,Math.min(max,n));}\n  function num(v,def){var n=Number(v);return isFinite(n)?n:def;}\n  function toast(msg){\n    var e=$(\'toast\');e.textContent=msg;e.classList.add(\'show\');\n    clearTimeout(window.__toastTimer);window.__toastTimer=setTimeout(function(){e.classList.remove(\'show\');},2100);\n  }\n  // ===== CLIENT-VISIBLE DEPLOYMENT LIMITS ===============================\n  // Python injects these values from the Web Dev Project Library constants.\n  // They improve UI feedback only; the server enforces every limit again.\n  var MAX_DASHBOARDS=window.PMD_CONFIG.maxDashboardsPerOwner;\n  var MAX_TAGS_BY_WIDGET=window.PMD_CONFIG.maxTagsByWidget;\n  var MAX_AXES_PER_TREND=window.PMD_CONFIG.maxAxesPerTrend;\n  var MAX_QUERY_MONTHS=window.PMD_CONFIG.maxQueryMonths;\n  var MONTH_IN_MS=30*24*60*60*1000;\n  var GRID_COLUMNS=window.PMD_CONFIG.gridColumns;\n  var GRID_ROWS=window.PMD_CONFIG.gridRows;\n  var MAX_HISTORY_POINTS_PER_TAG=window.PMD_CONFIG.maxHistoryPointsPerTag;\n  var COLORS=[\'#ff9f43\',\'#66b4ff\',\'#bc8cff\',\'#4fd1a5\',\'#ffd166\',\'#fb7185\',\'#75e5f1\',\'#a7d66c\'];\n\n  // Per-dashboard opening range defaults, supplied by server constants.\n  var DEFAULT_OPENING_LIVE_AMOUNT=window.PMD_CONFIG.defaultOpeningLiveAmount;\n  var DEFAULT_OPENING_LIVE_UNIT=window.PMD_CONFIG.defaultOpeningLiveUnit;\n  var DEFAULT_OPENING_AUTO_REFRESH=window.PMD_CONFIG.defaultOpeningAutoRefresh;\n  var DEFAULT_OPENING_POLL_SECONDS=window.PMD_CONFIG.defaultOpeningPollSeconds;\n\n  // Browser API helper. All requests are same-origin POSTs to the mounted\n  // Web Dev resource. The server derives the user from Ignition\'s session.\n  function apiCall(action,payload){\n    return fetch(window.PMD_CONFIG.apiPostPath,{\n      method:\'POST\',\n      credentials:\'same-origin\',\n      headers:{\'Content-Type\':\'application/json\'},\n      body:JSON.stringify({action:action,payload:payload||{}})\n    }).then(function(response){\n      return response.json().catch(function(){return {ok:false,error:\'The server returned an invalid response.\'};});\n    }).then(function(result){\n      if(!result||result.ok!==true)throw new Error((result&&result.error)||\'Request failed.\');\n      return result.data;\n    });\n  }\n  // Browser fullscreen permission must be requested synchronously inside the\n  // click event. This saves the dashboard first using a small synchronous\n  // request only for that transition; normal saves remain asynchronous.\n  function apiCallSync(action,payload){\n    var xhr=new XMLHttpRequest();\n    xhr.open(\'POST\',window.PMD_CONFIG.apiPostPath,false);\n    xhr.setRequestHeader(\'Content-Type\',\'application/json\');\n    try{\n      xhr.send(JSON.stringify({action:action,payload:payload||{}}));\n      var result=JSON.parse(xhr.responseText||\'{}\');\n      if(!result||result.ok!==true)throw new Error((result&&result.error)||\'Request failed.\');\n      return result.data;\n    }catch(error){\n      throw new Error(error.message||\'Could not save dashboard.\');\n    }\n  }\n\n  // Generic starter configuration. Production dashboards begin empty of\n  // process-specific paths; users add only server-approved historian tags.\n  var DEFAULT_AXES=[\n    {id:\'axis-primary\',label:\'Primary\',name:\'Primary\',type:\'Analog\',dataFormat:\'Auto\',side:\'Left\',offset:0,width:64,min:\'Auto\',max:\'Auto\',units:\'\',precision:1,color:\'#75b7ff\',visible:true}\n  ];\n  function blankTag(mode){\n    mode=mode||\'Analog\';\n    return {\n      id:uid(\'tag\'),\n      name:\'Select a historian tag\',\n      path:\'\',\n      type:mode===\'Digital\'?\'Boolean\':(mode===\'State\'?\'Integer State\':\'Float\'),\n      source:\'\',\n      axis:\'axis-primary\',\n      color:\'#75b7ff\',\n      width:2,\n      mode:mode,\n      lineType:\'Solid\',\n      visible:true,\n      aggregate:\'Raw stored values\',\n      interpolation:\'Inherit\',\n      breakOnMissingData:true\n    };\n  }\n  var DEFAULT_TAGS=[blankTag(\'Analog\')];\n\n  // ===== JSON-FRIENDLY WIDGET CONFIGURATION ============================\n  // ===== JSON-FRIENDLY WIDGET CONFIGURATION ============================\n  // Widget objects contain grid placement plus configuration safe to save.\n  function trendConfig(){\n    return {\n      axes:clone(DEFAULT_AXES),\n      tags:[],\n      style:{\n        showLegend:true,\n        showGrid:true,\n        background:\'Default dark\',\n        // Default applied when an analog pen is set to "Use chart default".\n        interpolation:\'Linear\',\n        // Solid is full opacity. Transparent keeps a subtle red reference cue.\n        referenceLineStyle:\'Solid\'\n      },\n      timeScope:\'Dashboard\'\n    };\n  }\n\n  // Normalizes older saved trend JSON into the current configuration shape.\n  // This keeps existing dashboards usable after new configurable fields are\n  // introduced, rather than requiring users to rebuild every trend.\n  function axisDisplayLabel(axis){\n    return String(axis&&axis.label!==undefined?axis.label:((axis&&axis.name)||\'Axis\'));\n  }\n  function axisDataFormat(axis){\n    return (axis&&axis.dataFormat)||\'Auto\';\n  }\n  function normalizeAxisRangeInput(value){\n    var text=String(value===undefined||value===null?\'\':value).trim();\n    if(!text||text.toLowerCase()===\'auto\')return \'Auto\';\n    var numeric=Number(text);\n    return isFinite(numeric)?String(numeric):\'Auto\';\n  }\n  function axisRangeIsValid(axis){\n    if(axis.min===\'Auto\'||axis.max===\'Auto\')return true;\n    return num(axis.min,0)<num(axis.max,0);\n  }\n  function ensureTrendConfig(cfg){\n    if(!cfg.axes)cfg.axes=[];\n    if(!cfg.tags)cfg.tags=[];\n    if(!cfg.style)cfg.style={};\n    if(cfg.style.showLegend===undefined)cfg.style.showLegend=true;\n    if(cfg.style.showGrid===undefined)cfg.style.showGrid=true;\n    if(!cfg.style.background)cfg.style.background=\'Default dark\';\n    if(!cfg.style.interpolation)cfg.style.interpolation=\'Linear\';\n    if(!cfg.style.referenceLineStyle)cfg.style.referenceLineStyle=\'Solid\';\n\n    cfg.axes.forEach(function(axis,index){\n      if(axis.label===undefined)axis.label=axis.name||(\'Axis \'+(index+1));\n      if(!axis.name)axis.name=axis.label;\n      if(!axis.type)axis.type=\'Analog\';\n      if(!axis.dataFormat)axis.dataFormat=\'Auto\';\n      if(!axis.side)axis.side=\'Left\';\n      if(axis.offset===undefined)axis.offset=0;\n      if(axis.width===undefined)axis.width=58;\n      axis.min=normalizeAxisRangeInput(axis.min);\n      axis.max=normalizeAxisRangeInput(axis.max);\n      if(axis.precision===undefined)axis.precision=1;\n      if(axis.visible===undefined)axis.visible=true;\n    });\n\n    cfg.tags.forEach(function(tag){\n      if(!tag.mode)tag.mode=\'Analog\';\n      if(!tag.aggregate)tag.aggregate=\'Raw stored values\';\n      if(!tag.lineType)tag.lineType=\'Solid\';\n      if(!tag.width)tag.width=2;\n      if(!tag.interpolation)tag.interpolation=\'Inherit\';\n      // v17 had a global connect-null setting. Existing saved charts migrate\n      // to the equivalent per-pen behavior the first time they are rendered.\n      if(tag.breakOnMissingData===undefined){\n        tag.breakOnMissingData=cfg.style.connectNulls===true?false:true;\n      }\n      if(tag.mode!==\'Analog\')tag.aggregate=\'Raw stored values\';\n    });\n  }\n  function penInterpolation(tag,cfg){\n    if(tag.mode!==\'Analog\')return \'Linear\';\n    var selected=tag.interpolation||\'Inherit\';\n    return selected===\'Inherit\'?(cfg.style.interpolation||\'Linear\'):selected;\n  }\n  function penBreaksOnMissingData(tag){\n    return tag.breakOnMissingData!==false;\n  }\n\n  // ===== WIDGET CATALOG =================================================\n  // ===== WIDGET CATALOG =================================================\n  // Every widget follows the same linked reference time. Live full-range view\n  // uses current values; historical and inspection view use the stored value\n  // at the red reference line.\n  var WIDGET_TYPES=[\n    {type:\'trend\',icon:\'⌁\',name:\'Trend chart\',desc:\'Multi-axis raw historian trend for analog, integer, Boolean, and state data.\',w:12,h:8,timeSupport:\'both\'},\n    {type:\'value\',icon:\'◉\',name:\'Reference value\',desc:\'One tag value at the shared red reference time.\',w:4,h:4,timeSupport:\'both\'},\n    {type:\'status\',icon:\'●\',name:\'Digital status\',desc:\'Boolean or state indication at the shared red reference time.\',w:4,h:4,timeSupport:\'both\'},\n    {type:\'timeline\',icon:\'▦\',name:\'State timeline\',desc:\'Time-band view showing when an integer or enum process state changed.\',w:8,h:6,timeSupport:\'both\'},\n    {type:\'table\',icon:\'≡\',name:\'Reference-value table\',desc:\'Selected tag values at the shared red reference time.\',w:10,h:6,timeSupport:\'both\'},\n    {type:\'stat\',icon:\'∑\',name:\'Range statistic\',desc:\'One historian-derived calculation across the visible Trend Chart window.\',w:6,h:4,timeSupport:\'both\'},\n    {type:\'statebreakdown\',icon:\'◔\',name:\'State duration\',desc:\'Breakdown of how long the process spent in each state over the range.\',w:8,h:6,timeSupport:\'both\'},\n    {type:\'events\',icon:\'☷\',name:\'Recent events\',desc:\'Chronological tag transitions for the selected time range.\',w:10,h:6,timeSupport:\'both\'}\n  ];\n  function makeWidget(type,id,x,y,w,h){\n    var titleMap={\n      trend:\'Trend Chart\',\n      value:\'Reference Value\',\n      status:\'Digital Status\',\n      timeline:\'State Timeline\',\n      table:\'Reference-value Table\',\n      stat:\'Range Statistic\',\n      statebreakdown:\'State Duration\',\n      events:\'Recent Events\'\n    };\n    var base={id:id||uid(type),type:type,title:titleMap[type],x:x||0,y:y||0,w:w||4,h:h||4,showHeader:true,contentScale:5};\n    if(type===\'trend\'){base.config=trendConfig();}\n    if(type===\'value\'){base.config={tag:blankTag(\'Analog\'),units:\'\',precision:1,showDelta:false,accent:\'#75b7ff\',timeScope:\'Dashboard\'};}\n    if(type===\'status\'){base.config={tag:blankTag(\'Digital\'),onText:\'On\',offText:\'Off\',trueColor:\'#4fd1a5\',falseColor:\'#fb7185\',timeScope:\'Dashboard\'};}\n    if(type===\'timeline\'){base.config={tag:blankTag(\'State\'),stateLabels:{0:\'Idle\',1:\'State 1\',2:\'State 2\',3:\'State 3\'},timeScope:\'Dashboard\'};}\n    if(type===\'table\'){base.config={tags:[],timeScope:\'Dashboard\'};}\n    if(type===\'stat\'){base.config={tag:blankTag(\'Analog\'),metric:\'Average\',stateValue:0,units:\'\',precision:1,accent:\'#75b7ff\',timeScope:\'Dashboard\'};}\n    if(type===\'statebreakdown\'){base.config={tag:blankTag(\'State\'),stateLabels:{0:\'Idle\',1:\'State 1\',2:\'State 2\',3:\'State 3\'},timeScope:\'Dashboard\'};}\n    if(type===\'events\'){base.config={tags:[],maxRows:5,timeScope:\'Dashboard\'};}\n    return base;\n  }\n  function initialWidgets(){\n    return [makeWidget(\'trend\',\'trend-main\',0,0,24,16)];\n  }\n  function initialWidgets(){\n    return [\n      makeWidget(\'trend\',\'trend-main\',0,0,16,10),\n      makeWidget(\'value\',\'value-temp\',16,0,4,4),\n      makeWidget(\'status\',\'status-run\',20,0,4,4),\n      makeWidget(\'timeline\',\'timeline-main\',16,4,8,6),\n      makeWidget(\'table\',\'table-main\',0,10,16,6)\n    ];\n  }\n  // ===== SESSION RUNTIME STATE =========================================\n  // Temporary viewing state stays separate from saved dashboard JSON.\n  var state={\n    currentDashboardId:null,\n    selectedWidgetId:null,\n    activeTab:\'dashboard\',\n    editMode:false,\n    dirty:false,\n    fullscreen:false,\n    drag:null,\n    charts:{},\n    session:{trend:{}},\n    // Server-derived data only. There are no generated demo samples in the\n    // production app. Each series key is its tag path plus aggregation mode.\n    data:{historyRows:{},currentValues:{},asOfValues:{},loading:false,requestToken:0},\n    sync:{zoom:{start:0,end:100},sourceWidgetId:null,syncing:false},\n    time:{mode:\'live\',amount:8,unit:\'Hours\',autoRefresh:true,pollSeconds:10,start:null,end:null,anchorEnd:Date.now()},\n    selectedTag:{path:\'\',name:\'\',type:\'Float\',source:\'\',mode:\'Analog line\',axis:\'axis-primary\'},\n    tagBrowser:{mode:\'add\',targetTagId:null,currentPath:null},\n    user:{username:\'\',displayName:\'\'},\n    dashboards:[],\n    shared:[]\n  };\n  function dashboard(){return state.dashboards.find(function(d){return d.id===state.currentDashboardId;});}\n  function widget(){\n    var d=dashboard();\n    return d&&d.widgets?d.widgets.find(function(w){return w.id===state.selectedWidgetId;}):null;\n  }\n  function widgetType(type){return WIDGET_TYPES.find(function(t){return t.type===type;});}\n  function markDirty(){\n    state.dirty=true;\n    $(\'saveStatus\').textContent=\'Unsaved changes\';\n    $(\'saveStatus\').classList.add(\'unsaved\');\n  }\n  function markSaved(){\n    state.dirty=false;\n    $(\'saveStatus\').textContent=\'Saved\';\n    $(\'saveStatus\').classList.remove(\'unsaved\');\n  }\n  // ===== LINKED TIME / REFERENCE MODEL ================================\n  // The red reference line drives single-value widgets. Range Statistic and\n  // other range-based widgets calculate across the full visible trend window.\n  function resetSeriesCache(){\n    state.data.historyRows={};\n    state.data.currentValues={};\n    state.data.asOfValues={};\n  }\n  function refreshDataSnapshot(){\n    // Freeze a live right edge for one complete server request. It moves only\n    // when manual refresh or automatic polling initiates a new request.\n    if(state.time.mode===\'live\')state.time.anchorEnd=Date.now();\n    resetSeriesCache();\n  }\n  // Converts a selected global range unit into milliseconds.\n  function rangeUnitMilliseconds(unit){\n    var normalized=(unit||\'Hours\').toLowerCase();\n    if(normalized===\'seconds\')return 1000;\n    if(normalized===\'minutes\')return 60000;\n    if(normalized===\'hours\')return 3600000;\n    if(normalized===\'days\')return 86400000;\n    if(normalized===\'weeks\')return 604800000;\n    if(normalized===\'months\')return MONTH_IN_MS;\n    return 3600000;\n  }\n  function maxQueryDurationMs(){\n    return MAX_QUERY_MONTHS*MONTH_IN_MS;\n  }\n  function maxAmountForRangeUnit(unit){\n    return Math.max(1,Math.floor(maxQueryDurationMs()/rangeUnitMilliseconds(unit)));\n  }\n  function boundedLiveAmount(amount,unit){\n    return clamp(Math.round(num(amount,1)),1,maxAmountForRangeUnit(unit));\n  }\n  function normalizeLiveRange(showNotice){\n    var original=Math.max(1,Math.round(num(state.time.amount,1)));\n    var bounded=boundedLiveAmount(original,state.time.unit);\n    if(bounded!==original&&showNotice){\n      toast(\'Maximum data range is \'+MAX_QUERY_MONTHS+\' months. Live range adjusted to \'+bounded+\' \'+state.time.unit+\'.\');\n    }\n    state.time.amount=bounded;\n    if($(\'rangeAmount\'))$(\'rangeAmount\').value=bounded;\n    return bounded;\n  }\n  function selectedHistoryRange(){\n    var start=new Date($(\'startDate\').value).getTime();\n    var end=new Date($(\'endDate\').value).getTime();\n    return {start:start,end:end};\n  }\n  function historyRangeIsAllowed(range,showNotice){\n    if(!isFinite(range.start)||!isFinite(range.end)||range.end<=range.start){\n      if(showNotice)toast(\'Choose a valid historical start and end time.\');\n      return false;\n    }\n    if(range.end-range.start>maxQueryDurationMs()){\n      if(showNotice)toast(\'Maximum data range is \'+MAX_QUERY_MONTHS+\' months. Choose a shorter historical window.\');\n      return false;\n    }\n    return true;\n  }\n\n  // ===== DASHBOARD OPENING LIVE RANGE ==================================\n  // This is saved with the dashboard configuration. It is intentionally\n  // separate from state.time, which is the temporary current-session range.\n  function defaultOpeningLiveRange(){\n    return {amount:DEFAULT_OPENING_LIVE_AMOUNT,unit:DEFAULT_OPENING_LIVE_UNIT};\n  }\n  function validRangeUnit(unit){\n    return [\'Seconds\',\'Minutes\',\'Hours\',\'Days\',\'Weeks\',\'Months\'].indexOf(unit)>=0;\n  }\n  function normalizeDashboardOpeningRange(d){\n    if(!d.openingLiveRange)d.openingLiveRange=defaultOpeningLiveRange();\n    if(!validRangeUnit(d.openingLiveRange.unit)){\n      d.openingLiveRange.unit=DEFAULT_OPENING_LIVE_UNIT;\n    }\n    d.openingLiveRange.amount=boundedLiveAmount(\n      d.openingLiveRange.amount,\n      d.openingLiveRange.unit\n    );\n    return d.openingLiveRange;\n  }\n  function openingRangeDescription(d){\n    var opening=normalizeDashboardOpeningRange(d);\n    return \'Last \'+opening.amount+\' \'+opening.unit;\n  }\n  function localDateTimeValue(timestamp){\n    var date=new Date(timestamp),offset=date.getTimezoneOffset()*60000;\n    return new Date(date-offset).toISOString().slice(0,16);\n  }\n  function applyDashboardOpeningLiveRange(d,skipRender){\n    // Always open at a fresh current timestamp. Saved history dates, zoom/pan,\n    // and temporary global time controls never carry between openings.\n    var opening=normalizeDashboardOpeningRange(d);\n    state.time.mode=\'live\';\n    state.time.amount=opening.amount;\n    state.time.unit=opening.unit;\n    state.time.autoRefresh=DEFAULT_OPENING_AUTO_REFRESH;\n    state.time.pollSeconds=DEFAULT_OPENING_POLL_SECONDS;\n    state.time.anchorEnd=Date.now();\n    state.time.start=localDateTimeValue(\n      state.time.anchorEnd-opening.amount*rangeUnitMilliseconds(opening.unit)\n    );\n    state.time.end=localDateTimeValue(state.time.anchorEnd);\n    $(\'startDate\').value=state.time.start;\n    $(\'endDate\').value=state.time.end;\n    $(\'rangeAmount\').value=state.time.amount;\n    $(\'rangeUnit\').value=state.time.unit;\n    $(\'pollRate\').value=state.time.pollSeconds;\n    resetLinkedView();\n    refreshDataSnapshot();\n    syncTimeUi();\n    updatePolling();\n    if(!skipRender)renderDashboard();\n  }\n  function timeWindow(){\n    var anchor=state.time.anchorEnd||Date.now();\n    if(state.