    return {
        "appTitle": APP_TITLE,
        "appVersion": APP_VERSION,
        "configSchemaVersion": CONFIG_SCHEMA_VERSION,
        "apiPostPath": API_POST_PATH,
        "echartsAssetPath": ECHARTS_ASSET_PATH,
        "gridColumns": GRID_COLUMNS,
        "gridRows": GRID_ROWS,
        "maxDashboardsPerOwner": MAX_DASHBOARDS_PER_OWNER,
        "maxTagsByWidget": MAX_TAGS_BY_WIDGET,
        "maxAxesPerTrend": MAX_AXES_PER_TREND,
        "maxQueryMonths": MAX_QUERY_MONTHS,
        "maxHistoryPointsPerTag": MAX_HISTORY_POINTS_PER_TAG,
        "defaultOpeningLiveAmount": DEFAULT_OPENING_LIVE_AMOUNT,
        "defaultOpeningLiveUnit": DEFAULT_OPENING_LIVE_UNIT,
        "defaultOpeningAutoRefresh": DEFAULT_OPENING_AUTO_REFRESH,
        "defaultOpeningPollSeconds": DEFAULT_OPENING_POLL_SECONDS,
        "allowedRoots": _root_payloads()
    }

def _response_ok(data):
    return {"json": {"ok": True, "data": data}}

def _response_error(message):
    return {"json": {"ok": False, "error": message}}

def _parse_post_body(request):
    try:
        raw = request.get("data")
    except:
        raw = request["data"] if "data" in request else None
    if raw is None:
        try:
            raw = request.get("postData")
        except:
            raw = None
    raw = _to_plain(raw)
    if isinstance(raw, basestring):
        if len(raw.encode("utf-8")) > MAX_JSON_REQUEST_BYTES:
            raise DashboardError("Request is too large.")
        raw = _json_load(raw, "POST body")
    body = _require_dict(raw or {}, "POST body")
    return body

def handle_get(request, session):
    try:
        _session_identity(session)
        config_json = json.dumps(_client_config(), separators=(",", ":"), ensure_ascii=False)
        page = HTML_TEMPLATE.replace("__PMD_CLIENT_CONFIG__", config_json)
        return {"html": page}
    except DashboardError as exc:
        return {"html": "<h1>Access denied</h1><p>%s</p>" % _text(exc)}
    except Exception as exc:
        _logger().error("GET failure: %s" % _text(exc))
        return {"html": "<h1>Plant Metrics Dashboard could not start.</h1><p>Check gateway logs and deployment constants.</p>"}

def handle_post(request, session):
    try:
        identity = _session_identity(session)
        body = _parse_post_body(request)
        action = _safe_text(body.get("action"), 120, "Action", False)
        payload = body.get("payload", {})

        if action == "dashboard.bootstrap":
            dashboards = _list_owned_dashboards(identity)
            if not dashboards:
                dashboards = [_create_default_dashboard(identity)]
            return _response_ok({
                "user": identity,
                "dashboards": dashboards,
                "allowedRoots": _root_payloads(),
                "limits": _client_config()
            })
        if action == "dashboard.get":
            payload = _require_dict(payload, "Dashboard request")
            dashboard_id = _safe_text(payload.get("id"), 80, "Dashboard id", False)
            return _response_ok({"dashboard": _get_dashboard_for_view(identity, dashboard_id)})
        if action == "dashboard.create":
            payload = _require_dict(payload, "Create payload")
            dashboard = _create_dashboard_row(
                identity,
                payload.get("name", "Untitled Dashboard"),
                payload.get("description", ""),
                payload.get("config", _default_dashboard_config())
            )
            return _response_ok({"dashboard": dashboard})
        if action == "dashboard.save":
            return _response_ok({"dashboard": _save_dashboard(identity, payload)})
        if action == "dashboard.delete":
            _delete_dashboard(identity, payload)
            return _response_ok({"deleted": True})
        if action == "dashboard.copy":
            return _response_ok({"dashboard": _copy_dashboard(identity, payload)})
        if action == "dashboard.listShared":
            return _response_ok({"dashboards": _shared_dashboard_summaries(identity)})
        if action == "tag.browse":
            return _response_ok(_browse_tags(payload))
        if action == "data.historyBatch":
            return _response_ok(_history_batch(payload))
        if action == "data.readCurrentBatch":
            return _response_ok(_read_current_batch(payload))
        if action == "data.asOfBatch":
            return _response_ok(_as_of_batch(payload))

        raise DashboardError("Unknown dashboard action.")
    except DashboardError as exc:
        return _response_error(_text(exc))
    except Exception as exc:
        _logger().error("POST failure: %s" % _text(exc))
        return _response_error("The server could not complete this request. Check gateway logs.")


