# ============================================================================
# BASIC HELPERS
# ============================================================================

class DashboardError(Exception):
    pass

def _logger():
    return system.util.getLogger(LOGGER_NAME)

def _text(value):
    if value is None:
        return ""
    try:
        return unicode(value)
    except:
        return str(value)

def _safe_text(value, limit, field_name, allow_empty=True):
    value = _text(value).strip()
    if not allow_empty and not value:
        raise DashboardError("%s is required." % field_name)
    if len(value) > limit:
        raise DashboardError("%s is too long." % field_name)
    if u"\x00" in value:
        raise DashboardError("%s contains an invalid character." % field_name)
    return value

def _as_int(value, default_value=0):
    try:
        return int(value)
    except:
        return default_value

def _as_float(value, default_value=0.0):
    try:
        return float(value)
    except:
        return default_value

def _as_bool(value):
    return value is True or _text(value).lower() in ("1", "true", "yes", "on")

def _java_date(epoch_ms):
    return Date(long(epoch_ms))

def _epoch_ms(value):
    if value is None:
        return None
    try:
        return long(value.getTime())
    except:
        try:
            return long(value)
        except:
            return None

def _json_load(value, field_name):
    if isinstance(value, basestring):
        try:
            return json.loads(value)
        except Exception as exc:
            raise DashboardError("%s is not valid JSON." % field_name)
    return value

def _to_plain(value):
    """Converts Java/Py objects into JSON-friendly Python values."""
    if value is None:
        return None
    if isinstance(value, (basestring, int, long, float, bool)):
        return value
    if isinstance(value, dict):
        return dict([(k, _to_plain(v)) for k, v in value.items()])
    try:
        # Java Map / list-like objects are normalized through Ignition JSON.
        return json.loads(system.util.jsonEncode(value))
    except:
        return _text(value)

def _require_dict(value, field_name):
    value = _to_plain(value)
    if not isinstance(value, dict):
        raise DashboardError("%s must be an object." % field_name)
    return value

def _require_list(value, field_name):
    value = _to_plain(value)
    if not isinstance(value, list):
        raise DashboardError("%s must be a list." % field_name)
    return value

def _valid_identifier(name, field_name):
    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", name or ""):
        raise DashboardError("%s must contain only letters, digits, and underscores." % field_name)
    return name

def _qualified_table():
    schema = _valid_identifier(DATABASE_SCHEMA_NAME, "DATABASE_SCHEMA_NAME")
    table = _valid_identifier(DASHBOARD_TABLE_NAME, "DASHBOARD_TABLE_NAME")
    return "[%s].[%s]" % (schema, table)
def _row_value(row, name, default=None):
    try:
        return row[name]
    except:
        try:
            return row.get(name, default)
        except:
            return default

# ============================================================================
# BUILT-IN IGNITION SESSION IDENTITY
# ============================================================================

def _user_property(user, method_names, attribute_names):
    for method_name in method_names:
        try:
            method = getattr(user, method_name)
            value = method()
            if value is not None and _text(value):
                return _text(value)
        except:
            pass
    for attribute_name in attribute_names:
        try:
            value = getattr(user, attribute_name)
            if value is not None and _text(value):
                return _text(value)
        except:
            pass
        try:
            value = user[attribute_name]
            if value is not None and _text(value):
                return _text(value)
        except:
            pass
    return ""

def _session_identity(session):
    # Web Dev resource Require Authentication is the access control. This only
    # reads the authenticated user object placed in the built-in session.
    try:
        user = session.get("user")
    except:
        try:
            user = session["user"]
        except:
            user = None
    if user is None:
        raise DashboardError("This Web Dev resource requires an authenticated Ignition session.")

    username = _user_property(
        user,
        ["getUsername", "getUserName", "getName"],
        ["username", "userName", "name"]
    )
    display_name = _user_property(
        user,
        ["getDisplayName", "getFullName", "getName"],
        ["displayName", "fullName", "name"]
    )
    if not username:
        raise DashboardError("Ignition did not provide an authenticated username for this session.")
    if not display_name:
        display_name = username
    return {
        "username": username,
        "displayName": display_name
    }

# ============================================================================
# DATABASE HELPERS
# ============================================================================

def _query_rows(query, args):
    dataset = system.db.runPrepQuery(query, args, DATABASE_CONNECTION_NAME)
    headers = list(system.dataset.getColumnHeaders(dataset))
    rows = []
    for row_index in range(dataset.getRowCount()):
        row = {}
        for column_index in range(len(headers)):
            row[headers[column_index]] = dataset.getValueAt(row_index, column_index)
        rows.append(row)
    return rows
def _query_one(query, args):
    rows = _query_rows(query, args)
    return rows[0] if rows else None

def _run_update(query, args):
    return system.db.runPrepUpdate(query, args, DATABASE_CONNECTION_NAME)

def _dashboard_select_sql(extra_where):
    return """
        SELECT
            DashboardId,
            OwnerUsername,
            OwnerDisplayName,
            DashboardName,
            DashboardDescription,
            IsShared,
            ConfigSchemaVersion,
            ConfigJson,
            CONVERT(varchar(34), RowVersion, 1) AS RowVersionHex,
            CreatedAt,
            UpdatedAt
        FROM %s
        %s
    """ % (_qualified_table(), extra_where)

def _decode_dashboard_row(row):
    try:
        config = json.loads(_text(_row_value(row, "ConfigJson", "{}")))
    except:
        raise DashboardError("A saved dashboard contains invalid ConfigJson.")

    config = _validate_dashboard_config(config, allow_empty_widgets=False)
    return {
        "id": _text(_row_value(row, "DashboardId")),
        "ownerUsername": _text(_row_value(row, "OwnerUsername")),
        "ownerDisplayName": _text(_row_value(row, "OwnerDisplayName")),
        "name": _text(_row_value(row, "DashboardName")),
        "description": _text(_row_value(row, "DashboardDescription")),
        "isShared": _as_bool(_row_value(row, "IsShared")),
        "savedIsShared": _as_bool(_row_value(row, "IsShared")),
        "configSchemaVersion": _as_int(_row_value(row, "ConfigSchemaVersion"), CONFIG_SCHEMA_VERSION),
        "rowVersion": _text(_row_value(row, "RowVersionHex")),
        "rows": config["rows"],
        "cols": config["cols"],
        "openingLiveRange": config["openingLiveRange"],
        "widgets": config["widgets"]
    }

def _fetch_dashboard_by_id(dashboard_id):
    row = _query_one(
        _dashboard_select_sql("WHERE DashboardId = ?"),
        [dashboard_id]
    )
    return _decode_dashboard_row(row) if row else None

def _fetch_owned_dashboard(dashboard_id, username):
    row = _query_one(
        _dashboard_select_sql("WHERE DashboardId = ? AND OwnerUsername = ?"),
        [dashboard_id, username]
    )
    return _decode_dashboard_row(row) if row else None

def _dashboard_count(username):
    row = _query_one(
        "SELECT COUNT(*) AS DashboardCount FROM %s WHERE OwnerUsername = ?" % _qualified_table(),
        [username]
    )
    return _as_int(_row_value(row, "DashboardCount"), 0)

def _unique_dashboard_name(username, requested_name):
    base = _safe_text(requested_name, MAX_DASHBOARD_NAME_LENGTH, "Dashboard name", False)
    candidate = base
    suffix = 2
    while _query_one(
        "SELECT DashboardId FROM %s WHERE OwnerUsername = ? AND DashboardName = ?" % _qualified_table(),
        [username, candidate]
    ):
        tail = " (%s)" % suffix
        candidate = base[:MAX_DASHBOARD_NAME_LENGTH - len(tail)] + tail
        suffix += 1
    return candidate

