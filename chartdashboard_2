def _root_payloads():
    output = []
    for item in ALLOWED_TAG_ROOTS:
        output.append({
            "provider": _text(item.get("provider", "")),
            "root": _text(item.get("root", "")),
            "label": _text(item.get("label", item.get("root", "")))
        })
    return output

def _is_history_enabled(path):
    if not REQUIRE_HISTORY_ENABLED_TAGS:
        return True
    try:
        configs = system.tag.getConfiguration(path, False)
        if not configs:
            return False
        config = configs[0]
        return _as_bool(config.get("historyEnabled", False))
    except:
        return False

def _node_value(node, name, default=None):
    try:
        return node[name]
    except:
        try:
            return node.get(name, default)
        except:
            return default

def _browse_tags(payload):
    payload = _require_dict(payload, "Browse payload")
    requested_path = _safe_text(payload.get("path", ""), 1024, "Browse path", True)

    if not requested_path:
        return {
            "nodes": [{
                "kind": "folder",
                "path": item["root"],
                "name": item["label"],
                "dataType": ""
            } for item in _root_payloads()]
        }

    path = _validate_tag_path(requested_path, False)
    results = system.tag.browse(path, {"maxResults": TAG_BROWSER_MAX_RESULTS})
    nodes = []
    for node in results:
        full_path = _text(_node_value(node, "fullPath", ""))
        name = _text(_node_value(node, "name", full_path))
        tag_type = _text(_node_value(node, "tagType", ""))
        data_type = _text(_node_value(node, "dataType", ""))
        if not full_path or not _is_allowed_path_quiet(full_path):
            continue
        kind = "folder" if "Folder" in tag_type or "UdtInstance" in tag_type else "tag"
        if kind == "tag" and not _is_history_enabled(full_path):
            continue
        nodes.append({
            "kind": kind,
            "path": full_path,
            "name": name,
            "dataType": data_type
        })
    return {"nodes": nodes}

def _is_allowed_path_quiet(path):
    try:
        _validate_tag_path(path, False)
        return True
    except:
        return False

